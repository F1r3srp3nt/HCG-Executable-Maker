<Project>
  <!--
    Build identity: the git commit (and whether the working tree had uncommitted changes) is embedded in
    HCG.ExecutableMaker.Core so the running app can show exactly which build it is (footer, Settings › About this build,
    and `HCGExecutableMaker - -version`). HCG_SOURCE_REVISION overrides git (e.g. for builds from a source archive).
    Without either, build-revision.txt next to this file is used: tools/self-package writes it into the imported copy,
    which has no .git, because Executable Maker's build environment removes every HCG_* variable.
  -->
  <Target Name="HcgEmbedBuildIdentity" BeforeTargets="GetAssemblyAttributes" Condition="'$(MSBuildProjectName)' == 'HCG.ExecutableMaker.Core'">
    <PropertyGroup><HcgRevisionFile>$(MSBuildThisFileDirectory)build-revision.txt</HcgRevisionFile></PropertyGroup>
    <ReadLinesFromFile File="$(HcgRevisionFile)" Condition="'$(HCG_SOURCE_REVISION)' == '' and Exists('$(HcgRevisionFile)')">
      <Output TaskParameter="Lines" PropertyName="HCG_SOURCE_REVISION" />
    </ReadLinesFromFile>
    <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low"
          WorkingDirectory="$(MSBuildThisFileDirectory)" Condition="'$(HCG_SOURCE_REVISION)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="HcgCommit" />
      <Output TaskParameter="ExitCode" PropertyName="HcgGitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low"
          WorkingDirectory="$(MSBuildThisFileDirectory)" Condition="'$(HCG_SOURCE_REVISION)' == '' and '$(HcgGitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="HcgGitStatus" />
    </Exec>
    <PropertyGroup>
      <HcgCommit Condition="'$(HCG_SOURCE_REVISION)' != ''">$(HCG_SOURCE_REVISION)</HcgCommit>
      <HcgCommit Condition="'$(HCG_SOURCE_REVISION)' == '' and '$(HcgGitExit)' != '0'">unknown</HcgCommit>
      <HcgCommit Condition="'$(HCG_SOURCE_REVISION)' == '' and '$(HcgGitExit)' == '0' and '$(HcgGitStatus)' != ''">$(HcgCommit)+uncommitted</HcgCommit>
    </PropertyGroup>
    <!-- Full source provenance for Maker's own Release Passport: build-source.txt (written by tools/self-package into
         the imported copy, which has no .git), else git in this checkout. Nothing is guessed: without either it is empty. -->
    <PropertyGroup>
      <HcgSourceFile>$(MSBuildThisFileDirectory)build-source.txt</HcgSourceFile>
      <HcgSourceText Condition="Exists('$(HcgSourceFile)')">$([System.IO.File]::ReadAllText('$(HcgSourceFile)'))</HcgSourceText>
      <HcgSourceCommit Condition="'$(HcgSourceText)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(HcgSourceText)', 'commit=([0-9a-f]{40})').Groups[1].Value)</HcgSourceCommit>
      <HcgSourceDirty Condition="'$(HcgSourceText)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(HcgSourceText)', 'dirty=(true|false)').Groups[1].Value)</HcgSourceDirty>
      <HcgSourceRepository Condition="'$(HcgSourceText)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(HcgSourceText)', 'repository=([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)').Groups[1].Value)</HcgSourceRepository>
    </PropertyGroup>
    <Exec Command="git rev-parse --verify HEAD" ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low"
          WorkingDirectory="$(MSBuildThisFileDirectory)" Condition="'$(HcgSourceText)' == '' and '$(HcgGitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="HcgSourceCommit" />
    </Exec>
    <PropertyGroup Condition="'$(HcgSourceText)' == '' and '$(HcgGitExit)' == '0'">
      <HcgSourceDirty Condition="'$(HcgGitStatus)' != ''">true</HcgSourceDirty>
      <HcgSourceDirty Condition="'$(HcgGitStatus)' == ''">false</HcgSourceDirty>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="HcgSourceCommit" Value="$(HcgSourceCommit)" />
      <AssemblyMetadata Include="HcgSourceDirty" Value="$(HcgSourceDirty)" />
      <AssemblyMetadata Include="HcgSourceRepository" Value="$(HcgSourceRepository)" />
      <AssemblyMetadata Include="HcgCommit" Value="$(HcgCommit)" />
      <AssemblyMetadata Include="HcgBuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" />
    </ItemGroup>
  </Target>
</Project>
