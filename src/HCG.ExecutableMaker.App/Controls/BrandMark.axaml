<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HCG.ExecutableMaker.App.Controls.BrandMark">
  <!--
    Shows the HCG logo from Assets/Branding/hcg-logo.png (currently the founder-provided TEMPORARY official logo).
    If that asset is ever missing, a clearly-marked text placeholder is shown instead — never an imitation logo.
    Regenerate the asset with tools/branding/make_logo.py when the final artwork arrives.
  -->
  <Panel>
    <Image x:Name="OfficialLogo" IsVisible="False" Stretch="Uniform" HorizontalAlignment="Left"
           RenderOptions.BitmapInterpolationMode="HighQuality" />
    <Border x:Name="Placeholder" Width="44" Height="44" HorizontalAlignment="Left"
            CornerRadius="11"
            BorderThickness="1"
            BorderBrush="{DynamicResource Hcg.Brush.MetalBorder}"
            Background="{DynamicResource Hcg.Brush.CyanFaint}"
            ToolTip.Tip="Placeholder mark — HCG logo asset missing (Assets/Branding/hcg-logo.png)">
      <TextBlock Text="HCG" FontSize="13" FontWeight="Bold" LetterSpacing="1.2"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{DynamicResource Hcg.Brush.MetalText}" />
    </Border>
  </Panel>
</UserControl>
