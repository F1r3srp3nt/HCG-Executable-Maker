<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HCG.ExecutableMaker.App.Views.Dialogs.LogViewerDialog"
        Width="1000" Height="680" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" Title="Build log">
  <DockPanel Margin="20">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Spacing="4">
        <TextBlock x:Name="TitleText" Classes="h2" />
        <TextBlock x:Name="PathText" Classes="muted mono" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="CopyButton" Classes="small" Content="Copy all" />
        <Button x:Name="CloseButton" Classes="small primary" Content="Close" IsCancel="True" />
      </StackPanel>
    </Grid>
    <Border Classes="inset" Padding="0" Background="{DynamicResource Hcg.Brush.LogBackground}">
      <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="{DynamicResource Hcg.Font.Mono}" FontSize="12"
               Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>
  </DockPanel>
</Window>
