<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HCG.ExecutableMaker.App.Views.Dialogs.PasswordDialog"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/Branding/hcg-app-icon.png" ShowInTaskbar="False"
        Title="HCG Executable Maker">
  <Border Padding="28" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Hcg.Brush.AccentGradient}">
    <StackPanel Spacing="14">
      <TextBlock x:Name="TitleText" Classes="h2" TextWrapping="Wrap" />
      <TextBlock x:Name="MessageText" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                 Foreground="{DynamicResource Hcg.Brush.TextSecondary}" />
      <TextBox x:Name="PasswordBox" PasswordChar="•" RevealPassword="False" Watermark="Password" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="The password opens the file in memory only. It is not saved, logged or passed to another program." />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,6,0,0">
        <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
        <Button x:Name="ConfirmButton" Classes="primary" Content="Import" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
