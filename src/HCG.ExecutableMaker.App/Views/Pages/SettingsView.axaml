<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HCG.ExecutableMaker.App.ViewModels"
             xmlns:s="using:HCG.ExecutableMaker.App.Services"
             x:Class="HCG.ExecutableMaker.App.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.formlabel">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextSecondary}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource Hcg.Padding.Page}" Spacing="18" MaxWidth="1000" HorizontalAlignment="Left">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Appearance" />
          <ListBox Classes="plain selectable" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="s:ThemeOption">
                <Border Classes="card compact interactive" Margin="0,0,10,0">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="h3" Text="{Binding Name}" />
                      <Border Classes="chip info" IsVisible="{Binding IsPreview}"><TextBlock Text="Preview" /></Border>
                    </StackPanel>
                    <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Import safety limits" />
            <TextBlock Classes="muted" Text="Archives and folders exceeding these limits are rejected before anything is kept." />
          </StackPanel>
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="formlabel" Text="MAX TOTAL SIZE (GB)" />
              <NumericUpDown Value="{Binding MaxImportGb}" Minimum="0.01" Maximum="200" Increment="0.5" FormatString="0.##" />
            </StackPanel>
            <StackPanel Margin="4,0,4,0">
              <TextBlock Classes="formlabel" Text="MAX SINGLE FILE (GB)" />
              <NumericUpDown Value="{Binding MaxFileGb}" Minimum="0.01" Maximum="100" Increment="0.5" FormatString="0.##" />
            </StackPanel>
            <StackPanel Margin="8,0,0,0">
              <TextBlock Classes="formlabel" Text="MAX FILE COUNT" />
              <NumericUpDown Value="{Binding MaxFiles}" Minimum="1" Maximum="1000000" Increment="1000" FormatString="0" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="Build defaults" />
          <UniformGrid Columns="3">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="formlabel" Text="BUILD TIME LIMIT (MINUTES)" />
              <NumericUpDown Value="{Binding TimeoutMinutes}" Minimum="1" Maximum="720" Increment="5" FormatString="0" />
            </StackPanel>
          </UniformGrid>
          <StackPanel>
            <TextBlock Classes="formlabel" Text="DEFAULT OUTPUT DIRECTORY" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding DefaultOutput}" FontFamily="{DynamicResource Hcg.Font.Mono}" FontSize="12" />
              <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
            </Grid>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="Save Settings" Command="{Binding SaveCommand}" />
            <TextBlock Classes="success" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Data locations" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Classes="label" Text="DATA ROOT" Margin="0,3" />
            <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding DataRoot}" Margin="0,3" />
            <TextBlock Grid.Row="1" Classes="label" Text="DATABASE" Margin="0,3" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding DatabasePath}" Margin="0,3" />
            <TextBlock Grid.Row="2" Classes="label" Text="WORKSPACES" Margin="0,3" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding WorkspacesPath}" Margin="0,3" />
            <TextBlock Grid.Row="3" Classes="label" Text="LOGS" Margin="0,3" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="mono" Text="{Binding LogsPath}" Margin="0,3" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="small" Content="Open Data Folder" Command="{Binding OpenDataFolderCommand}" />
            <Button Classes="small" Content="Open Logs Folder" Command="{Binding OpenLogsFolderCommand}" />
          </StackPanel>
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="The database stores metadata only (projects, builds, artifacts, checksums). It never stores passwords, certificates or private keys." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Apple credentials" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Used only by the explicit Notarize and Validate steps. HCG stores names and IDs; passwords stay in your login keychain and API keys in their key file. Nothing is uploaded or submitted automatically." />
          </StackPanel>
          <TextBlock Classes="h3" Text="Notarization (notarytool keychain profile)" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="1. Create an app-specific password at account.apple.com. 2. Run the command below in Terminal; notarytool asks for the password and stores it in your login keychain. 3. Enter the profile name here and press Check." />
          <Grid ColumnDefinitions="*,*,*" >
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="formlabel" Text="PROFILE NAME" />
              <TextBox Text="{Binding NotaryProfile}" PlaceholderText="HCG-Notary" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
              <TextBlock Classes="formlabel" Text="APPLE ID (FOR THE COMMAND ONLY)" />
              <TextBox Text="{Binding NotaryAppleId}" PlaceholderText="you@example.com" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="formlabel" Text="TEAM ID (FOR THE COMMAND ONLY)" />
              <TextBox Text="{Binding NotaryTeamId}" PlaceholderText="ABCDE12345" />
            </StackPanel>
          </Grid>
          <Border Classes="inset" Padding="12,10">
            <SelectableTextBlock Classes="mono" Text="{Binding StoreCredentialsCommand}" TextWrapping="Wrap" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="small" Content="Copy command" Command="{Binding CopyStoreCredentialsCommandCommand}" />
            <Button Classes="small" Content="Check profile" Command="{Binding CheckNotaryProfileCommand}" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" Text="{Binding NotaryStatus}" TextWrapping="Wrap" />

          <TextBlock Classes="h3" Text="App Store Connect validation (API key)" Margin="0,8,0,0" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Create a key in App Store Connect › Users and Access › Integrations › App Store Connect API, save the downloaded .p8 as ~/.appstoreconnect/private_keys/AuthKey_&lt;KeyID&gt;.p8, and enter the IDs here." />
          <Grid ColumnDefinitions="*,*">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Classes="formlabel" Text="KEY ID" />
              <TextBox Text="{Binding AscKeyId}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="formlabel" Text="ISSUER ID" />
              <TextBox Text="{Binding AscIssuerId}" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="muted" FontSize="12" Text="{Binding AscStatus}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="12" Text="Press Save settings (above) to keep these names and IDs." TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="About" />
          <Image Source="/Assets/Branding/hcg-logo.png" Height="64" HorizontalAlignment="Left" Margin="-4,6,0,4" Stretch="Uniform" />
          <TextBlock Text="{Binding Version, StringFormat='HCG Executable Maker {0}'}" />
          <TextBlock Classes="formlabel" Text="ABOUT THIS BUILD" Margin="0,10,0,4" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Classes="muted" Text="Commit" />
            <SelectableTextBlock Grid.Column="1" FontFamily="{DynamicResource Hcg.Font.Mono}" FontSize="12" Text="{Binding Commit}" />
            <TextBlock Grid.Row="1" Classes="muted" Text="Built (UTC)" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontFamily="{DynamicResource Hcg.Font.Mono}" FontSize="12" Text="{Binding BuildDate}" />
            <TextBlock Grid.Row="2" Classes="muted" Text="Executable" />
            <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontFamily="{DynamicResource Hcg.Font.Mono}" FontSize="12" Text="{Binding ExecutablePath}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Classes="muted" Text="App bundle" />
            <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontFamily="{DynamicResource Hcg.Font.Mono}" FontSize="12" Text="{Binding AppBundlePath}" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="From a terminal: &lt;executable&gt; --version prints the same identity without opening the window." />
          <TextBlock Classes="muted" Text="© Hakmi Capital Group. Built with .NET 10 and Avalonia UI." Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
