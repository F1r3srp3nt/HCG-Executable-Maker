<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HCG.ExecutableMaker.App.ViewModels"
             xmlns:c="using:HCG.ExecutableMaker.App.Controls"
             x:Class="HCG.ExecutableMaker.App.Views.Pages.ImpactorView"
             x:DataType="vm:ImpactorViewModel">
  <UserControl.Resources>
    <!-- HCG Impactor accent: cyan → violet over the dark metallic surfaces. -->
    <LinearGradientBrush x:Key="Impactor.Accent" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#00D9FF" />
      <GradientStop Offset="1" Color="#9B5CFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Impactor.Glow" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#2600D9FF" />
      <GradientStop Offset="1" Color="#269B5CFF" />
    </LinearGradientBrush>
    <DataTemplate x:Key="FindingTemplate" x:DataType="vm:ImpFindingItem">
      <Grid ColumnDefinitions="Auto,*" Margin="0,4">
        <c:StatusChip Status="{Binding Tag}" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
          <TextBlock FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"><Run Text="{Binding Title}" /><Run Text="  " /><Run Classes="muted" Text="{Binding Subject}" /></TextBlock>
          <SelectableTextBlock FontSize="12.5" Text="{Binding Detail}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding Remedy}" TextWrapping="Wrap" IsVisible="{Binding HasRemedy}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="KeyValueTemplate" x:DataType="vm:ImpKeyValueItem">
      <Grid ColumnDefinitions="200,*" Margin="0,2">
        <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Key}" TextWrapping="Wrap" />
        <SelectableTextBlock Grid.Column="1" FontSize="12.5" Text="{Binding Value}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.dropzone">
      <Setter Property="BorderBrush" Value="{StaticResource Impactor.Accent}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{StaticResource Impactor.Glow}" />
      <Setter Property="Padding" Value="22" />
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.82" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.dropzone.dragover">
      <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="ListBox.sections">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.sections ListBoxItem">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.18" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.sections ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Impactor.Glow}" />
    </Style>
    <Style Selector="ListBox.sections ListBoxItem:selected PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Violet}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- HEADER: flow + status -->
    <Border Grid.Row="0" Margin="24,16,24,8" Classes="card" Padding="18,14">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="eyebrow" Text="HCG IMPACTOR" Foreground="{DynamicResource Hcg.Brush.Violet}" />
          <TextBlock Classes="h2" Text="Drop IPA → Inspect → Sign → Select device → Install" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Command="{Binding BrowseIpaCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{DynamicResource Icon.Zip}" Width="14" Height="14" /><TextBlock Text="Open IPA…" /></StackPanel>
        </Button>
        <Border Grid.Row="1" Grid.ColumnSpan="2" Height="2" Margin="0,10" CornerRadius="1" Background="{StaticResource Impactor.Accent}" />
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*">
          <ItemsControl ItemsSource="{Binding FlowSteps}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ImpStepChip"><c:StatusChip Status="{Binding Tag}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Grid.Column="1" Margin="14,0,0,0" Classes="muted" FontSize="12.5" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>

    <!-- SECTIONS -->
    <ListBox Grid.Row="1" Margin="24,0,24,4" Classes="sections" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSectionItem}">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ImpactorSectionItem">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{Binding Icon, Converter={x:Static vm:ToneConverters.IconFromKey}}" Width="13" Height="13" Foreground="{DynamicResource Hcg.Brush.Cyan}" />
            <TextBlock Text="{Binding Title}" FontSize="12.5" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="24,8,24,24" Spacing="14">
        <Border Classes="callout error" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="error" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />

        <!-- ============================== DASHBOARD -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowDashboard}">
          <Border x:Name="DropZone" Classes="dropzone" DragDrop.AllowDrop="True">
            <StackPanel Spacing="6" HorizontalAlignment="Center">
              <PathIcon Data="{DynamicResource Icon.Export}" Width="30" Height="30" Foreground="{DynamicResource Hcg.Brush.Cyan}" HorizontalAlignment="Center" />
              <TextBlock Classes="h3" HorizontalAlignment="Center" Text="Drop an .ipa here" />
              <TextBlock Classes="muted" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                         Text="HCG Impactor inspects it first. The original file is never changed; signing always writes a new IPA." />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="THIS COMPUTER" />
              <TextBlock FontSize="13" Text="{Binding PlatformText}" />
              <TextBlock Classes="warning" FontSize="12.5" TextWrapping="Wrap" Text="{Binding PlatformLimitation}" IsVisible="{Binding HasPlatformLimitation}" />
            </StackPanel>
          </Border>
          <UniformGrid Columns="4">
            <Border Classes="card compact" Margin="0,0,10,0"><StackPanel><TextBlock Classes="stat" Text="{Binding StatsDevices}" /><TextBlock Classes="muted" Text="devices connected" /></StackPanel></Border>
            <Border Classes="card compact" Margin="0,0,10,0"><StackPanel><TextBlock Classes="stat" Text="{Binding StatsIdentities}" /><TextBlock Classes="muted" Text="signing identities" /></StackPanel></Border>
            <Border Classes="card compact" Margin="0,0,10,0"><StackPanel><TextBlock Classes="stat" Text="{Binding StatsProfiles}" /><TextBlock Classes="muted" Text="usable profiles" /></StackPanel></Border>
            <Border Classes="card compact"><StackPanel><TextBlock Classes="stat" Text="{Binding StatsApps}" /><TextBlock Classes="muted" Text="apps signed" /></StackPanel></Border>
          </UniformGrid>
          <Border Classes="card" IsVisible="{Binding Reminders.Count}">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="SIGNING REMINDERS" />
              <ItemsControl ItemsSource="{Binding Reminders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ImpFindingItem">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,3"><c:StatusChip Status="{Binding Tag}" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" Text="{Binding Detail}" TextWrapping="Wrap" /></Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="HCG ECOSYSTEM" />
              <ItemsControl ItemsSource="{Binding Integrations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ImpKeyValueItem">
                    <StackPanel Margin="0,4"><TextBlock FontWeight="SemiBold" FontSize="12.5" Text="{Binding Key}" /><TextBlock Classes="muted" FontSize="12" Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="HCG Impactor installs standard signed IPAs through Apple's supported tools. It does not bypass code signing, provisioning or device authorization, never removes apps, and never uploads to App Store Connect or TestFlight. Jailbreak .deb packages use the separate HCG Repo workflow." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============================== IPA INSPECTOR -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowInspector}">
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel>
                <TextBlock Classes="h2" Text="{Binding IpaTitle}" />
                <SelectableTextBlock Classes="muted" FontSize="12.5" Text="{Binding IpaSubtitle}" TextWrapping="Wrap" />
                <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding IpaPath}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Margin="8,0" Content="Open IPA…" Command="{Binding BrowseIpaCommand}" VerticalAlignment="Top" />
              <Button Grid.Column="2" Classes="primary" Content="Next: Signing Studio" Command="{Binding GoCommand}" CommandParameter="Signing" IsEnabled="{Binding HasIpa}" VerticalAlignment="Top" />
            </Grid>
          </Border>
          <Border Classes="card" IsVisible="{Binding IpaFindings.Count}">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="FINDINGS" />
              <ItemsControl ItemsSource="{Binding IpaFindings}" ItemTemplate="{StaticResource FindingTemplate}" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding HasIpa}">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="INSPECTION REPORT" />
              <ItemsControl ItemsSource="{Binding IpaFacts}" ItemTemplate="{StaticResource KeyValueTemplate}" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding Bundles.Count}">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="EXTENSIONS, FRAMEWORKS AND LIBRARIES" />
              <ItemsControl ItemsSource="{Binding Bundles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ImpBundleItem">
                    <Border Classes="inset" Margin="0,3" Padding="10">
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" FontSize="12.5"><Run Text="{Binding Kind}" /><Run Text=" · " /><Run Text="{Binding Path}" /></TextBlock>
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Identifier}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" />
                        <TextBlock FontSize="12" Text="{Binding Signature}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding Entitlements.Count}">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="ENTITLEMENTS (CURRENT SIGNATURE)" />
              <ItemsControl ItemsSource="{Binding Entitlements}" ItemTemplate="{StaticResource KeyValueTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============================== SIGNING STUDIO -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowSigning}">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="SIGN OR RE-SIGN" />
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,8,Auto,8,Auto">
                <TextBlock Classes="formlabel" Text="Identity" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding IdentityChoices}" SelectedItem="{Binding SelectedIdentity}" />
                <TextBlock Grid.Row="2" Classes="formlabel" Text="Profile (app)" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedProfile}" />
                <TextBlock Grid.Row="4" Classes="formlabel" Text="Distribution" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" MinWidth="240" ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" />
              </Grid>
              <ToggleButton Classes="ghost" IsChecked="{Binding ShowAdvanced}" Content="Advanced options" HorizontalAlignment="Left" />
              <Border Classes="inset" Padding="12" IsVisible="{Binding ShowAdvanced}">
                <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,8,Auto,8,Auto">
                  <TextBlock Classes="formlabel" Text="New bundle ID" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding NewBundleId}" PlaceholderText="Keep the original (recommended — a new ID installs as a separate app without the original's data)" />
                  <TextBlock Grid.Row="2" Classes="formlabel" Text="Entitlements" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" IsChecked="{Binding DropUnsupported}" Content="Remove entitlements the profile does not grant (each removal is reported)" />
                  <TextBlock Grid.Row="4" Classes="formlabel" Text="Output" VerticalAlignment="Center" />
                  <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OutputPath}" PlaceholderText="Next to the original: &lt;name&gt;-signed.ipa (never overwrites)" />
                  <Button Grid.Row="4" Grid.Column="2" Margin="8,0,0,0" Content="Folder…" Command="{Binding ChooseOutputCommand}" />
                </Grid>
              </Border>
              <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding PlanSummary}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding SignCommand}" IsEnabled="{Binding PlanReady}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{DynamicResource Icon.Security}" Width="14" Height="14" /><TextBlock Text="Sign and verify" /></StackPanel>
                </Button>
                <Button Content="Re-check" Command="{Binding BuildPlanCommand}" />
                <Button Classes="ghost" Content="Refresh identities and profiles" Command="{Binding RefreshInventoryCommand}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Signing uses Apple's codesign with your Keychain identity (private keys never leave the Keychain), embeds each bundle's profile, signs frameworks and extensions first, verifies with codesign --verify --deep --strict and inspects the new IPA again." />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding Assignments.Count}">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="PLAN — INNERMOST FIRST" />
              <ItemsControl ItemsSource="{Binding Assignments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ImpAssignmentItem">
                    <Grid ColumnDefinitions="220,*" Margin="0,3">
                      <TextBlock FontWeight="SemiBold" FontSize="12.5" Text="{Binding Bundle}" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="1">
                        <TextBlock FontSize="12.5"><Run Text="{Binding Identifier}" /><Run Text=" · " /><Run Text="{Binding Profile}" /></TextBlock>
                        <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Entitlements}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding PlanFindings.Count}">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="SIGNING READINESS" />
              <ItemsControl ItemsSource="{Binding PlanFindings}" ItemTemplate="{StaticResource FindingTemplate}" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding SignLog.Count}">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="SIGNING LOG" />
              <ItemsControl ItemsSource="{Binding SignLog}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="mono" FontSize="11.5" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <SelectableTextBlock Classes="success" FontSize="12.5" Text="{Binding SignResult}" TextWrapping="Wrap" IsVisible="{Binding SignResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Button Classes="primary" Content="Next: choose a device" Command="{Binding GoCommand}" CommandParameter="Devices" IsVisible="{Binding SignResult, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============================== SIGNING DOCTOR -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowDoctor}">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="SIGNING DOCTOR" />
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="Exactly why each provisioning profile on this Mac can or cannot sign an app: bundle identifier, team, certificate, expirations, registered device, development vs distribution and entitlements. Read-only." />
              <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                <TextBlock Classes="formlabel" Text="Bundle ID" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DoctorBundleId}" PlaceholderText="e.g. com.hakmicapitalgroup.hcgmail (default: the loaded IPA)" />
                <TextBlock Grid.Row="2" Classes="formlabel" Text="Entitlements" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DoctorEntitlementsPath}" PlaceholderText="The app's .entitlements file (optional; default: the loaded IPA's)" />
                <Button Grid.Row="2" Grid.Column="2" Margin="8,0,0,0" Content="Choose…" Command="{Binding BrowseEntitlementsCommand}" />
                <TextBlock Grid.Row="4" Classes="formlabel" Text="Team" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" MinWidth="200" ItemsSource="{Binding DoctorTeams}" SelectedItem="{Binding DoctorTeam}" PlaceholderText="Any team" />
                <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding DoctorUseDevice}" Content="Check registration of the connected device (Device Manager)" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Diagnose" Command="{Binding RunDoctorCommand}" />
                <CheckBox IsChecked="{Binding ProvisionRegisterDevice}" Content="Register the connected device" VerticalAlignment="Center"
                          ToolTip.Tip="Off by default. When on, Xcode may add the connected iPhone/iPad to your team's devices (-allowProvisioningDeviceRegistration)." />
                <Button Content="Create profile with Xcode…" Command="{Binding CreateProfileCommand}" IsEnabled="{Binding CanCreateProfile}"
                        ToolTip.Tip="Uses the Apple Account signed in to Xcode: a throwaway stub app is built once with xcodebuild -allowProvisioningUpdates to register the App ID (and the connected device) and download a Development profile. Asks for your approval first." />
              </StackPanel>
              <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DoctorSummary}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding DoctorFindings}" ItemTemplate="{StaticResource FindingTemplate}" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding DoctorSteps.Count}">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="WHAT TO DO" />
              <ItemsControl ItemsSource="{Binding DoctorSteps}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock FontSize="12.5" Margin="0,3" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <ItemsControl ItemsSource="{Binding ProvisionLog}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Classes="mono" FontSize="11" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <SelectableTextBlock FontSize="12.5" Text="{Binding ProvisionResult}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding DoctorProfiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ImpDoctorProfile">
                <Border Classes="card compact" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                        <SelectableTextBlock Classes="muted" FontSize="11.5" Text="{Binding Detail}" />
                      </StackPanel>
                      <c:StatusChip Grid.Column="1" Status="{Binding Tag}" VerticalAlignment="Top" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Checks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImpDoctorCheck">
                          <Grid ColumnDefinitions="Auto,200,*" Margin="0,2">
                            <c:StatusChip Status="{Binding Tag}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Margin="8,0" FontSize="12" Classes="muted" Text="{Binding Title}" />
                            <TextBlock Grid.Column="2" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ============================== DEVICE MANAGER -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowDevices}">
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="h3" Text="iPhones and iPads" />
                <TextBlock Classes="muted" FontSize="12.5" Text="{Binding DevicesNote}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Command="{Binding RefreshDevicesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{DynamicResource Icon.Refresh}" Width="13" Height="13" /><TextBlock Text="Refresh" /></StackPanel>
              </Button>
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ImpDeviceItem">
                <Border Classes="card" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" ToolTip.Tip="Include in the Deployment Queue" />
                      <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Classes="h3" Text="{Binding Name}" />
                        <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Model}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <c:StatusChip Status="{Binding ConnectionTag}" /><c:StatusChip Status="{Binding PairingTag}" /><c:StatusChip Status="{Binding DeveloperModeTag}" /><c:StatusChip Status="{Binding InstallTag}" />
                      </StackPanel>
                    </Grid>
                    <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding Identity}" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Capabilities}" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Text="{Binding Registration}" TextWrapping="Wrap" />
                    <Border Classes="callout warning" Padding="10" IsVisible="{Binding HasGuidance}"><TextBlock FontSize="12.5" Text="{Binding Guidance}" TextWrapping="Wrap" /></Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="primary small" Content="Install here" Command="{Binding $parent[UserControl].((vm:ImpactorViewModel)DataContext).UseDeviceCommand}" CommandParameter="{Binding}" />
                      <Button Classes="small" Content="Copy device record" Command="{Binding $parent[UserControl].((vm:ImpactorViewModel)DataContext).CopyDeviceRecordCommand}" CommandParameter="{Binding}" />
                      <Button Classes="small ghost" Content="Open in HCG System Tester" Command="{Binding $parent[UserControl].((vm:ImpactorViewModel)DataContext).OpenInSystemTesterCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ============================== DEPLOYMENT QUEUE -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowQueue}">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="label" Text="INSTALL" />
              <Grid ColumnDefinitions="150,*,Auto">
                <TextBlock Classes="formlabel" Text="Signed IPA" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SignedIpaPath}" PlaceholderText="Sign in Signing Studio, or choose a signed IPA" />
                <Button Grid.Column="2" Margin="8,0,0,0" Content="Choose…" Command="{Binding BrowseSignedIpaCommand}" />
              </Grid>
              <CheckBox IsChecked="{Binding LaunchAfterInstall}" Content="Launch the app after installing (when the device allows it)" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Devices: the ones ticked in Device Manager (several = batch installation, one after another). Every device is checked before anything is sent to it. A failed installation never removes the existing app." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check" Command="{Binding CheckDeploymentCommand}" />
                <Button Classes="primary" Command="{Binding InstallCommand}" IsEnabled="{Binding !Installing}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{DynamicResource Icon.Play}" Width="12" Height="12" /><TextBlock Text="Install" /></StackPanel>
                </Button>
                <Button Classes="danger" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding Installing}" />
              </StackPanel>
              <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="{Binding QueueSummary}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding QueueItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ImpQueueItem">
                <Border Classes="card compact" Margin="0,0,0,8">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h3" Text="{Binding Device.Name}" />
                      <c:StatusChip Grid.Column="1" Status="{Binding Tag}" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="4" />
                    <TextBlock FontSize="12.5" Text="{Binding Status}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card" IsVisible="{Binding QueueChecks.Count}">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="PRE-INSTALLATION CHECKS" />
              <ItemsControl ItemsSource="{Binding QueueChecks}" ItemTemplate="{StaticResource FindingTemplate}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============================== CERTIFICATES -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowCertificates}">
          <Border Classes="callout">
            <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="Signing identities from this Mac's Keychain. HCG never reads private keys, and never revokes or replaces certificates. Create or renew certificates in Xcode › Settings › Accounts › Manage Certificates; import a .p12 in Signing &amp; Security." />
          </Border>
          <ItemsControl ItemsSource="{Binding Identities}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ImpIdentityItem">
                <Border Classes="card compact" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Classes="muted" FontSize="12"><Run Text="{Binding Kind}" /><Run Text=" · team " /><Run Text="{Binding Team}" /><Run Text=" · expires " /><Run Text="{Binding Expires}" /></TextBlock>
                      <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding Sha1}" />
                    </StackPanel>
                    <c:StatusChip Grid.Column="1" Status="{Binding Tag}" VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="warning" FontSize="12.5" Text="{Binding InventoryNote}" TextWrapping="Wrap" IsVisible="{Binding InventoryNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <!-- ============================== PROVISIONING -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowProfiles}">
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Text="Profiles from Xcode's folders, verified (CMS signature and Apple chain). Profiles that cover the loaded app are listed first." />
              <Button Grid.Column="1" Margin="8,0" Content="Add profile…" Command="{Binding AddProfileFileCommand}" />
              <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshInventoryCommand}" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ImpProfileItem">
                <Border Classes="card compact" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Classes="muted" FontSize="12"><Run Text="{Binding Kind}" /><Run Text=" · " /><Run Text="{Binding AppId}" /><Run Text=" · expires " /><Run Text="{Binding Expires}" /></TextBlock>
                      <TextBlock Classes="muted" FontSize="12"><Run Text="{Binding Devices}" /><Run Text=" · " /><Run Text="{Binding Certificates}" /><Run Text=" · " /><Run Text="{Binding Fit}" /></TextBlock>
                      <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding Uuid}" />
                    </StackPanel>
                    <c:StatusChip Grid.Column="1" Status="{Binding Tag}" VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ============================== SIGNING MONITOR -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowMonitor}">
          <Border Classes="callout warning">
            <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="Apple limits how long a signed app runs: until the certificate or the provisioning profile expires (7 days for a free Apple Account, up to a year for paid membership). Apple does not allow permanent signing or background re-signing — re-sign and reinstall manually before the date shown." />
          </Border>
          <ItemsControl ItemsSource="{Binding SignedApps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ImpSignedAppItem">
                <Border Classes="card compact" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding App}" />
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                      <TextBlock FontSize="12"><Run Text="Valid until " /><Run Text="{Binding Expires}" /></TextBlock>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Classes="small" Content="Re-sign" Command="{Binding $parent[UserControl].((vm:ImpactorViewModel)DataContext).ResignCommand}" CommandParameter="{Binding}" />
                        <Button Classes="small ghost" Content="Reinstall" Command="{Binding $parent[UserControl].((vm:ImpactorViewModel)DataContext).ReinstallCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                    <c:StatusChip Grid.Column="1" Status="{Binding Tag}" VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ============================== HISTORY -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowHistory}">
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ImpHistoryItem">
                <Border Classes="card compact" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="140,*,Auto">
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding When}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock FontWeight="SemiBold" FontSize="12.5"><Run Text="{Binding App}" /><Run Text=" → " /><Run Text="{Binding Device}" /></TextBlock>
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <c:StatusChip Grid.Column="2" Status="{Binding Tag}" VerticalAlignment="Top" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ============================== DIAGNOSTICS -->
        <StackPanel Spacing="14" IsVisible="{Binding ShowDiagnostics}">
          <Border Classes="card" IsVisible="{Binding HasDiagnosis}">
            <StackPanel Spacing="8">
              <TextBlock Classes="h3" Text="{Binding DiagnosisTitle}" Foreground="{DynamicResource Hcg.Brush.Error}" />
              <TextBlock FontSize="13" Text="{Binding DiagnosisExplanation}" TextWrapping="Wrap" />
              <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding DiagnosisRemedy}" TextWrapping="Wrap" />
              <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding DiagnosisEvidence}" TextWrapping="Wrap" />
              <Expander Header="Original output (redacted)">
                <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding DiagnosisRaw}" TextWrapping="Wrap" />
              </Expander>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="EXPLAIN AN ERROR" />
              <TextBox Text="{Binding PastedOutput}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" PlaceholderText="Paste the output of Xcode, devicectl, ideviceinstaller or another tool …" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Explain" Command="{Binding DiagnosePastedCommand}" />
                <Button Classes="primary" Content="Export diagnostics…" Command="{Binding ExportDiagnosticsCommand}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Exports report.json in HCG's shared hcg.diagnostic-report/1 format (readable by HCG Sentinel and System Tester) and report.md. Credentials, UDIDs, ECIDs, serial numbers, e-mail addresses and user names are redacted." />
              <SelectableTextBlock Classes="success" FontSize="12.5" Text="{Binding ExportNote}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
