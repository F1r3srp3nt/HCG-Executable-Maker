<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HCG.ExecutableMaker.App.ViewModels"
             xmlns:c="using:HCG.ExecutableMaker.App.Controls"
             x:Class="HCG.ExecutableMaker.App.Views.Pages.ToolchainsView"
             x:DataType="vm:ToolchainsViewModel">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource Hcg.Padding.Page}" Spacing="18">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,*,*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Classes="label" Text="HOST" />
            <TextBlock Classes="h2" Text="{Binding HostName}" />
            <TextBlock Classes="muted" Text="{Binding HostDetail}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3" Margin="16,0">
            <TextBlock Classes="label" Text="HCG RUNTIME" />
            <TextBlock FontSize="13" Text="{Binding Runtime}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="3" Margin="16,0">
            <TextBlock Classes="label" Text="DISK SPACE" />
            <TextBlock FontSize="13" Text="{Binding DiskFree}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding DetectedAt}" />
          </StackPanel>
          <Button Grid.Column="3" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.Refresh}" /><TextBlock Text="Refresh" /></StackPanel>
          </Button>
        </Grid>
      </Border>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolchainGroup">
            <Border Classes="card" Margin="0,0,0,16">
              <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="{Binding Category}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolchainItem">
                      <StackPanel>
                        <Grid ColumnDefinitions="220,140,*,Auto" Margin="0,8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Version}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                            <SelectableTextBlock Classes="mono muted" Text="{Binding Location}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding Others}" IsVisible="{Binding HasOthers}" TextWrapping="Wrap" />
                            <TextBlock Classes="warning" FontSize="12" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" />
                          </StackPanel>
                          <c:StatusChip Grid.Column="3" Status="{Binding Status}" Margin="12,0,0,0" />
                        </Grid>
                        <Border Classes="divider" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="HCG Executable Maker never installs SDKs or system tools on its own. Follow the hints above to install a missing tool, then press Refresh." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
