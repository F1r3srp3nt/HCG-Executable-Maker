<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HCG.ExecutableMaker.App.ViewModels"
             xmlns:c="using:HCG.ExecutableMaker.App.Controls"
             x:Class="HCG.ExecutableMaker.App.Views.Pages.RootlessPackageView"
             x:DataType="vm:RootlessPackageViewModel">
  <ScrollViewer>
    <StackPanel Margin="{DynamicResource Hcg.Padding.Page}" Spacing="16">
      <Border Classes="callout">
        <TextBlock FontSize="12.5" TextWrapping="Wrap"
                   Text="Packages an iOS app that a build already produced (a device .app, an .xcarchive or an .ipa) as a rootless jailbreak .deb for HCG Repo Candidate. The app's code and capabilities are not changed: HCG adds no entitlements and refuses privileged ones. Nothing is installed, uploaded or published, and a validated package is not a device test." />
      </Border>

      <!-- 1 · INSPECT -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="1 · APP FROM A BUILD" />
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Text="{Binding Source}" PlaceholderText="…/HCGSentinel.xcarchive, …/HCGSentinel.app or …/HCGSentinel.ipa" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="App or archive…" Command="{Binding BrowseAppCommand}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Content="IPA…" Command="{Binding BrowseIpaCommand}" />
            <Button Grid.Column="3" Margin="8,0,0,0" Classes="ghost" Content="Inspect" Command="{Binding InspectCommand}" />
          </Grid>
          <SelectableTextBlock FontSize="12.5" Text="{Binding AppSummary}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" FontSize="12" Text="{Binding LdidStatus}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 2 · PACKAGE -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="2 · PACKAGE IDENTITY" />
          <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto,8,Auto">
            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding PackageId}" PlaceholderText="Package ID, e.g. com.hakmicapitalgroup.example" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PackageVersion}" PlaceholderText="Debian version, e.g. 1.0.0~beta1" />
            <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding AppName}" PlaceholderText="Display name" />
            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Maintainer}" PlaceholderText="Maintainer" />
            <TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Description}" PlaceholderText="Description (first line is the summary)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" />
          </Grid>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Use the package ID HCG Repo already records for the product. A published version is immutable: changed bytes need a new version." />
        </StackPanel>
      </Border>

      <!-- 3 · CANDIDATE -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="3 · CANDIDATE AND PROVENANCE" />
          <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto">
            <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding DeviceIos}" PlaceholderText="Test device iOS, e.g. 16.5" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding DeviceTarget}" PlaceholderText="Test device description" />
            <ComboBox Grid.Row="2" Grid.Column="0" ItemsSource="{Binding AccessLevels}" SelectedItem="{Binding ProductionAccess}" HorizontalAlignment="Stretch" ToolTip.Tip="The product's production access. It stays unchanged; this candidate version is a free public demo only in HCG Repo Candidate." />
            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Repository}" PlaceholderText="Source repository, e.g. F1r3srp3nt/HCG-Sentinel" />
            <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding Commit}" PlaceholderText="Exact source commit (40 characters)" />
            <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding CiRun}" PlaceholderText="CI run ID (needed for an importable request)" />
            <TextBox Grid.Row="6" Grid.Column="0" Text="{Binding CiArtifact}" PlaceholderText="CI artifact name" />
            <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding OutputDir}" PlaceholderText="Output folder" />
            <TextBox Grid.Row="8" Grid.Column="0" Text="{Binding CiRepository}" PlaceholderText="CI run's repository, if not the source repository" />
            <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding CiCommit}" PlaceholderText="Commit that CI run built (40 characters)" />
          </Grid>
          <Grid ColumnDefinitions="*,12,*">
            <TextBox Text="{Binding Changes}" PlaceholderText="Beta changelog, one change per line" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
            <TextBox Grid.Column="2" Text="{Binding KnownIssues}" PlaceholderText="Known issues, one per line" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 4 · BUILD, VALIDATE, HANDOFF -->
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="label" Text="4 · PACKAGE, VALIDATE AND EXPORT" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}">
              <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.Export}" /><TextBlock Text="Build package and handoff" /></StackPanel>
            </Button>
            <Button Classes="ghost" Content="Open output folder" Command="{Binding OpenOutputCommand}" />
            <c:StatusChip Status="{Binding ResultTag}" VerticalAlignment="Center" />
          </StackPanel>
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
          <ItemsControl ItemsSource="{Binding Stages}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StageItem">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                  <c:StatusChip Status="{Binding Tag}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <SelectableTextBlock Classes="mono" FontSize="12" Text="{Binding Result}" TextWrapping="Wrap" IsVisible="{Binding Result, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ItemsControl ItemsSource="{Binding Checks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CheckItem">
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                  <c:StatusChip Status="{Binding Status}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding Missing}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="warning" FontSize="12" Text="{Binding StringFormat='Missing: {0}'}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="label" Text="BUILD LOG" />
          <Border Classes="inset" Padding="10">
            <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding Log}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
