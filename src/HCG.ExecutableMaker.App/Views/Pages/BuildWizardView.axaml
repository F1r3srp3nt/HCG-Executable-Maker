<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HCG.ExecutableMaker.App.ViewModels"
             xmlns:c="using:HCG.ExecutableMaker.App.Controls"
             x:Class="HCG.ExecutableMaker.App.Views.Pages.BuildWizardView"
             x:DataType="vm:BuildWizardViewModel">
  <UserControl.Styles>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Divider}" />
      <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Input}" />
    </Style>
    <Style Selector="Border.step.active">
      <Setter Property="Background" Value="{DynamicResource Hcg.Brush.AccentGradient}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="{DynamicResource Hcg.Shadow.Glow}" />
    </Style>
    <Style Selector="Border.step.done">
      <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Cyan}" />
    </Style>
    <Style Selector="Border.step TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextMuted}" />
    </Style>
    <Style Selector="Border.step.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.OnAccent}" />
    </Style>
    <Style Selector="TextBlock.steptitle">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextMuted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.steptitle.active">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextPrimary}" />
    </Style>
    <Style Selector="TextBlock.steptitle.done">
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Cyan}" />
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="22" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Card}" />
    </Style>
    <Style Selector="TextBlock.log">
      <Setter Property="FontFamily" Value="{DynamicResource Hcg.Font.Mono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#B7C4D1" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBlock.log.error"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Error}" /></Style>
    <Style Selector="TextBlock.log.warning"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Warning}" /></Style>
    <Style Selector="TextBlock.log.success"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Success}" /></Style>
    <Style Selector="TextBlock.log.command"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Cyan}" /></Style>
    <Style Selector="TextBlock.log.info"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Silver}" /></Style>
    <Style Selector="TextBlock.formlabel">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextSecondary}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="36,22,36,22">
    <!-- ===== Step indicator ===== -->
    <Border Classes="card compact" Padding="20,14">
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StepItem">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <Border Classes="step" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}">
                <Panel>
                  <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsDone}" />
                  <PathIcon Data="{StaticResource Icon.Check}" Width="13" Height="13" Foreground="{DynamicResource Hcg.Brush.Cyan}" IsVisible="{Binding IsDone}" />
                </Panel>
              </Border>
              <TextBlock Grid.Column="1" Classes="steptitle" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}"
                         Text="{Binding Title}" VerticalAlignment="Center" Margin="10,0,10,0" />
              <Border Grid.Column="2" Classes="divider" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding !IsLast}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ===== Step content ===== -->
    <Panel Grid.Row="1" Margin="0,18,0,0">
      <ScrollViewer IsVisible="{Binding !IsBuildStep}">
        <StackPanel Spacing="18" Margin="0,0,6,0">

          <!-- STEP 1 · IMPORT -->
          <StackPanel Spacing="18" IsVisible="{Binding IsImportStep}">
            <UniformGrid Columns="2">
              <Button Classes="tile" Margin="0,0,9,0" Command="{Binding ImportZipCommand}" IsEnabled="{Binding !IsImporting}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Hcg.Brush.CyanSoft}" VerticalAlignment="Top">
                    <PathIcon Data="{StaticResource Icon.Zip}" Width="22" Height="22" Foreground="{DynamicResource Hcg.Brush.Cyan}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                    <TextBlock Classes="h2" Text="Import ZIP archive" />
                    <TextBlock Classes="body secondary" Text="Validated for corruption, path traversal, symlinks and size limits, then extracted into an isolated workspace. The original archive is preserved." />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="tile" Margin="9,0,0,0" Command="{Binding ImportFolderCommand}" IsEnabled="{Binding !IsImporting}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Hcg.Brush.CyanSoft}" VerticalAlignment="Top">
                    <PathIcon Data="{StaticResource Icon.Folder}" Width="22" Height="22" Foreground="{DynamicResource Hcg.Brush.Cyan}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="4">
                    <TextBlock Classes="h2" Text="Import project folder" />
                    <TextBlock Classes="body secondary" Text="A snapshot copy is made (bin, obj and .git excluded). Builds never write into your original folder." />
                  </StackPanel>
                </Grid>
              </Button>
            </UniformGrid>

            <Border Classes="card" IsVisible="{Binding IsImporting}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h3" Text="Importing…" />
                  <Button Grid.Column="1" Classes="small" Content="Cancel" Command="{Binding CancelImportCommand}" />
                </Grid>
                <ProgressBar IsIndeterminate="{Binding ImportIndeterminate}" Value="{Binding ImportPercent}" Maximum="100" />
                <TextBlock Classes="muted mono" Text="{Binding ImportStatus}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <Border Classes="callout error" IsVisible="{Binding ImportError, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="6">
                <TextBlock Classes="h3 error" Text="Import rejected" />
                <SelectableTextBlock Text="{Binding ImportError}" TextWrapping="Wrap" FontSize="12.5" />
              </StackPanel>
            </Border>

            <Border Classes="callout success" IsVisible="{Binding HasProject}">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Hcg.Brush.Success}" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,12,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Classes="h3" Text="{Binding ProjectTitle, StringFormat='Imported: {0}'}" />
                  <TextBlock Classes="muted" Text="{Binding ProjectSource}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding ImportWarnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="warning" FontSize="12" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasRecentProjects}">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="Previously imported" />
                <ItemsControl ItemsSource="{Binding RecentProjects}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectItem">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,6">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding Summary}" />
                        </StackPanel>
                        <c:StatusChip Grid.Column="1" Status="{Binding Status}" Margin="0,0,12,0" />
                        <Button Grid.Column="2" Classes="small" Content="Use project"
                                Command="{Binding $parent[UserControl].((vm:BuildWizardViewModel)DataContext).UseProjectCommand}" CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- STEP 2 · INSPECT -->
          <Grid ColumnDefinitions="3*,2*" IsVisible="{Binding IsInspectStep}">
            <StackPanel Spacing="18" Margin="0,0,9,0">
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Classes="h2" Text="Project analysis" VerticalAlignment="Center" />
                    <c:StatusChip Grid.Column="1" Status="{Binding SupportTag}" Margin="0,0,10,0" />
                    <Button Grid.Column="2" Classes="small" Command="{Binding ReinspectCommand}" IsEnabled="{Binding !IsInspecting}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Refresh}" />
                        <TextBlock Text="Re-inspect" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <!-- A folder with more than one kind of project (an Xcode iOS app and a Theos jailbreak project): the user chooses the route. -->
                  <StackPanel Spacing="6" IsVisible="{Binding HasBuildRoutes}">
                    <TextBlock Classes="formlabel" Text="Build route" Margin="0" />
                    <ComboBox ItemsSource="{Binding BuildRouteOptions}" SelectedItem="{Binding SelectedBuildRoute}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding BuildRouteDescription}" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Classes="body secondary" Text="{Binding Analysis.SupportSummary, FallbackValue=''}" />
                  <Button Classes="primary" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding OpenInMobileStudioCommand}" IsVisible="{Binding IsMobileProject}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.Mobile}" /><TextBlock Text="Open in Mobile Build Studio" /></StackPanel>
                  </Button>
                  <Border Classes="divider" />
                  <ItemsControl ItemsSource="{Binding AnalysisRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SummaryRow">
                        <Grid ColumnDefinitions="170,*" Margin="0,4">
                          <TextBlock Classes="label" Text="{Binding Label}" />
                          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="divider" />
                  <TextBlock Classes="formlabel" Text="{Binding ProjectPickerLabel}" Margin="0" />
                  <ComboBox ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}" PlaceholderText="{Binding ProjectPickerPlaceholder}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectChoice">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Classes="muted mono" Text="{Binding Path}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <!-- Swift package: trusted evaluation and executable product choice -->
                  <StackPanel Spacing="12" IsVisible="{Binding HasSelectedSwiftPackage}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h3" Text="Swift package" VerticalAlignment="Center" />
                      <c:StatusChip Grid.Column="1" Status="{Binding SwiftPackageTag}" />
                    </Grid>
                    <TextBlock Classes="body secondary" Text="{Binding SwiftPackageStatus}" TextWrapping="Wrap" />
                    <SelectableTextBlock Classes="muted mono" FontSize="11.5" Text="{Binding SwiftPackageFacts}" TextWrapping="Wrap" />
                    <Border Classes="callout warning" IsVisible="{Binding HasSwiftRemediation}">
                      <ItemsControl ItemsSource="{Binding SwiftRemediation}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock FontSize="12.5" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <Border Classes="inset" Padding="16,14" IsVisible="{Binding SwiftHostCanEvaluate}">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Evaluate Package.swift on this Mac" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Package.swift is Swift code. HCG has only read it as text so far. To list the products this Mac really builds (products declared under #if os(macOS) included), HCG runs 'swift package dump-package' through the same isolated build worker as a build: scrubbed environment, scratch space outside the project, cancellable, 5-minute limit." />
                        <CheckBox IsChecked="{Binding SwiftEvaluationTrusted}" IsEnabled="{Binding !IsEvaluatingSwift}">
                          <TextBlock Text="{Binding TrustLabel}" TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="primary" Content="Evaluate package" Command="{Binding EvaluateSwiftPackageCommand}" />
                          <Button Classes="ghost" Content="Cancel" Command="{Binding CancelSwiftEvaluationCommand}" IsVisible="{Binding IsEvaluatingSwift}" />
                          <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding IsEvaluatingSwift}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="callout error" IsVisible="{Binding SwiftEvaluationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <SelectableTextBlock FontSize="12.5" Text="{Binding SwiftEvaluationError}" TextWrapping="Wrap" />
                    </Border>
                    <Expander Header="Evaluation output" IsVisible="{Binding HasSwiftEvaluationLog}" HorizontalAlignment="Stretch">
                      <ScrollViewer MaxHeight="180">
                        <ItemsControl ItemsSource="{Binding SwiftEvaluationLog}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Expander>
                    <StackPanel Spacing="8" IsVisible="{Binding HasSwiftProducts}">
                      <TextBlock Classes="formlabel" Text="EXECUTABLE PRODUCT TO BUILD" Margin="0" />
                      <ComboBox ItemsSource="{Binding SwiftExecutableProducts}" SelectedItem="{Binding SelectedSwiftProduct}" PlaceholderText="Choose an executable product…" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:SwiftProductChoice">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding Display}" />
                              <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Grid ColumnDefinitions="170,*" Margin="0,4,0,0">
                        <TextBlock Classes="label" Text="Library products" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding SwiftLibrariesText}" FontSize="13" TextWrapping="Wrap" />
                      </Grid>
                      <Grid ColumnDefinitions="170,*">
                        <TextBlock Classes="label" Text="Test targets" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding SwiftTestsText}" FontSize="13" TextWrapping="Wrap" />
                      </Grid>
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Libraries and tests are not built into an app; only executable products are offered." />
                    </StackPanel>
                  </StackPanel>
                  <Border Classes="callout success" IsVisible="{Binding DesktopWorkspaceNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <SelectableTextBlock FontSize="12.5" Text="{Binding DesktopWorkspaceNotice}" TextWrapping="Wrap" />
                  </Border>
                  <!-- C/C++: CMake targets (after a trusted configure), Makefile targets, selected sources; Theos and others explained -->
                  <StackPanel Spacing="12" IsVisible="{Binding ShowNativePanel}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h3" Text="{Binding NativeKindLabel}" VerticalAlignment="Center" />
                      <c:StatusChip Grid.Column="1" Status="{Binding NativeTag}" />
                    </Grid>
                    <TextBlock Classes="body secondary" Text="{Binding NativeStatus}" TextWrapping="Wrap" />
                    <SelectableTextBlock Classes="muted mono" FontSize="11.5" Text="{Binding NativeFacts}" TextWrapping="Wrap" />
                    <Border Classes="callout warning" IsVisible="{Binding HasNativeToolchainGaps}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Installed toolchains — missing on this computer" FontWeight="SemiBold" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding NativeToolchainGaps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <SelectableTextBlock FontSize="12.5" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="small" HorizontalAlignment="Left" Content="Open Toolchains" Command="{Binding OpenToolchainsPageCommand}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding NativeNotes}" IsVisible="{Binding HasNativeNotes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Theos: jailbreak package (.deb), the configuration the project defines -->
                    <StackPanel Spacing="10" IsVisible="{Binding ShowNativeTheos}">
                      <Border Classes="inset" Padding="16,12">
                        <StackPanel Spacing="8">
                          <TextBlock Text="What the package contains" FontWeight="SemiBold" />
                          <SelectableTextBlock FontSize="12.5" Text="{Binding TheosProducts}" TextWrapping="Wrap" />
                          <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding TheosPackage}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="formlabel" Text="PACKAGE CONFIGURATION (DEFINED BY THE PROJECT'S MAKEFILE)" Margin="0" />
                        <ComboBox ItemsSource="{Binding TheosSchemes}" SelectedItem="{Binding SelectedTheosScheme}" HorizontalAlignment="Stretch" />
                        <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding TheosSchemeDetail}" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 Text="Each configuration builds in its own folder, so rootless and rootful packages never mix. HCG runs only 'make package' — never 'make install', never a respring, never a connection to a device — and checks the resulting .deb before showing it." />
                    </StackPanel>

                    <!-- CMake -->
                    <StackPanel Spacing="10" IsVisible="{Binding ShowNativeCMake}">
                      <Border Classes="inset" Padding="16,12">
                        <SelectableTextBlock FontSize="12.5" Text="{Binding NativeConfiguredSummary}" TextWrapping="Wrap" />
                      </Border>
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding NativeLibrariesText}" TextWrapping="Wrap"
                                 IsVisible="{Binding NativeLibrariesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Border Classes="inset" Padding="16,14">
                        <StackPanel Spacing="10">
                          <TextBlock Text="Configure with CMake on this computer" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" TextWrapping="Wrap"
                                     Text="Configuring runs the project's CMake code (and anything it executes). HCG runs it through the isolated build worker — scrubbed environment, its own build folder outside the project, cancellable, 10-minute limit — and reads the targets from the CMake File API. Downloads by FetchContent are blocked unless you allow them." />
                          <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Spacing="4">
                              <TextBlock Classes="formlabel" Text="CONFIGURE PRESET" Margin="0" />
                              <ComboBox ItemsSource="{Binding NativePresets}" SelectedItem="{Binding SelectedNativePreset}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                              <TextBlock Classes="formlabel" Text="BUILD TYPE" Margin="0" />
                              <ComboBox ItemsSource="{Binding NativeBuildTypes}" SelectedItem="{Binding SelectedNativeBuildType}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Spacing="4">
                            <TextBlock Classes="formlabel" Text="CACHE ENTRIES (ONE NAME=VALUE PER LINE, OPTIONAL)" Margin="0" />
                            <TextBox Text="{Binding NativeCacheEntriesText}" AcceptsReturn="True" MinHeight="54" FontFamily="{DynamicResource Hcg.Font.Mono}"
                                     Watermark="e.g. MYAPP_ENABLE_GUI=OFF" TextWrapping="NoWrap" />
                          </StackPanel>
                          <CheckBox IsChecked="{Binding NativeAllowDownloads}" IsEnabled="{Binding !IsConfiguringNative}">
                            <TextBlock TextWrapping="Wrap" Text="Allow the project to download dependencies while configuring (FetchContent / ExternalProject)" />
                          </CheckBox>
                          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding NativeHasDownloads}"
                                     Text="This project's CMake files use FetchContent or ExternalProject. Without downloads, configuration fails unless the dependency is already available." />
                          <CheckBox IsChecked="{Binding NativeConfigureTrusted}" IsEnabled="{Binding !IsConfiguringNative}">
                            <TextBlock Text="{Binding TrustLabel}" TextWrapping="Wrap" />
                          </CheckBox>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary" Content="Configure with CMake" Command="{Binding ConfigureNativeCommand}" />
                            <Button Classes="ghost" Content="Cancel" Command="{Binding CancelNativeConfigureCommand}" IsVisible="{Binding IsConfiguringNative}" />
                            <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding IsConfiguringNative}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Border Classes="callout error" IsVisible="{Binding NativeConfigureError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <SelectableTextBlock FontSize="12.5" Text="{Binding NativeConfigureError}" TextWrapping="Wrap" />
                      </Border>
                      <Expander Header="Configuration output" IsVisible="{Binding HasNativeConfigureLog}" HorizontalAlignment="Stretch">
                        <ScrollViewer MaxHeight="200">
                          <ItemsControl ItemsSource="{Binding NativeConfigureLog}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding}" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Expander>
                    </StackPanel>

                    <!-- Make -->
                    <StackPanel Spacing="10" IsVisible="{Binding ShowNativeMake}">
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 Text="HCG does not guess what a Makefile builds. Name the target and the file it produces; HCG copies the project into its own build folder, runs make there and packages exactly that file." />
                      <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="formlabel" Text="MAKE TARGET" Margin="0" />
                          <TextBox Text="{Binding NativeMakeTarget}" FontFamily="{DynamicResource Hcg.Font.Mono}" Watermark="e.g. all" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                          <TextBlock Classes="formlabel" Text="EXPECTED OUTPUT (RELATIVE TO THE PROJECT FOLDER)" Margin="0" />
                          <TextBox Text="{Binding NativeExpectedOutput}" FontFamily="{DynamicResource Hcg.Font.Mono}" Watermark="e.g. bin/myapp" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Spacing="4" IsVisible="{Binding HasNativeMakeTargets}">
                        <TextBlock Classes="formlabel" Text="TARGETS READ FROM THE MAKEFILE (CLICK TO USE)" Margin="0" />
                        <ItemsControl ItemsSource="{Binding NativeMakeTargets}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <Button Classes="small ghost" Margin="0,0,6,6" Content="{Binding}" FontFamily="{DynamicResource Hcg.Font.Mono}"
                                      Command="{Binding $parent[UserControl].((vm:BuildWizardViewModel)DataContext).UseNativeMakeTargetCommand}" CommandParameter="{Binding}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="formlabel" Text="MAKE VARIABLES (ONE NAME=VALUE PER LINE, OPTIONAL)" Margin="0" />
                        <TextBox Text="{Binding NativeMakeVariablesText}" AcceptsReturn="True" MinHeight="54" FontFamily="{DynamicResource Hcg.Font.Mono}" Watermark="e.g. PREFIX=/opt/app" />
                      </StackPanel>
                    </StackPanel>

                    <!-- Sources without a build system -->
                    <StackPanel Spacing="10" IsVisible="{Binding ShowNativeSources}">
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 Text="No build system was found. Choose exactly the files that make up one program (one main()). HCG writes a small CMakeLists.txt in its own build folder — never in the project — and compiles only the files you select." />
                      <Border Classes="inset" Padding="12,8">
                        <ScrollViewer MaxHeight="200">
                          <ItemsControl ItemsSource="{Binding NativeSourceItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:NativeSourceItem">
                                <CheckBox IsChecked="{Binding IsSelected}">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="mono" Text="{Binding Path}" />
                                    <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Detail}" />
                                  </StackPanel>
                                </CheckBox>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Border>
                      <Grid ColumnDefinitions="*,12,*,12,*">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="formlabel" Text="LANGUAGE" Margin="0" />
                          <ComboBox ItemsSource="{Binding NativeLanguages}" SelectedItem="{Binding SelectedNativeLanguage}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                          <TextBlock Classes="formlabel" Text="STANDARD" Margin="0" />
                          <ComboBox ItemsSource="{Binding NativeStandards}" SelectedItem="{Binding SelectedNativeStandard}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="4">
                          <TextBlock Classes="formlabel" Text="EXECUTABLE NAME" Margin="0" />
                          <TextBox Text="{Binding NativeOutputName}" FontFamily="{DynamicResource Hcg.Font.Mono}" />
                        </StackPanel>
                      </Grid>
                      <Expander Header="Generated build configuration (written to HCG's build folder)" HorizontalAlignment="Stretch">
                        <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding NativeGeneratedPreview}" TextWrapping="Wrap" />
                      </Expander>
                    </StackPanel>

                    <!-- Runtime files the app needs next to it -->
                    <StackPanel Spacing="4" IsVisible="{Binding ShowNativeRuntimeFiles}">
                      <TextBlock Classes="formlabel" Text="RUNTIME FILES TO SHIP NEXT TO THE EXECUTABLE (ONE PATH PER LINE, OPTIONAL)" Margin="0" />
                      <TextBox Text="{Binding NativeRuntimeFilesText}" AcceptsReturn="True" MinHeight="54" FontFamily="{DynamicResource Hcg.Font.Mono}" Watermark="e.g. assets/  or  data/config.ini (relative to the project folder)" />
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 Text="HCG copies the executable, the project's own shared libraries and the files listed here. It lists every library the binary loads (RUNTIME-DEPENDENCIES.txt) and warns about ones that are not system libraries — a binary is not portable just because it compiled." />
                    </StackPanel>

                    <Border Classes="callout warning" IsVisible="{Binding NativeConfigurationProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <SelectableTextBlock FontSize="12.5" Text="{Binding NativeConfigurationProblem}" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                  <!-- Electron app: what it is, what it still needs, and the build stages HCG will run -->
                  <StackPanel Spacing="12" IsVisible="{Binding IsElectronBuild}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h3" Text="Electron desktop app" VerticalAlignment="Center" />
                      <c:StatusChip Grid.Column="1" Status="{Binding ElectronTag}" />
                    </Grid>
                    <TextBlock Classes="body secondary" Text="{Binding ElectronStatus}" TextWrapping="Wrap" />
                    <SelectableTextBlock Classes="muted mono" FontSize="11.5" Text="{Binding ElectronFacts}" TextWrapping="Wrap" />
                    <Border Classes="callout warning" IsVisible="{Binding HasElectronRemediation}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Project configuration — change these in the project" FontWeight="SemiBold" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding ElectronRemediation}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <SelectableTextBlock FontSize="12.5" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Classes="callout warning" IsVisible="{Binding HasElectronToolchainRemediation}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Installed toolchains — missing on this computer" FontWeight="SemiBold" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding ElectronToolchainRemediation}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <SelectableTextBlock FontSize="12.5" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="small" HorizontalAlignment="Left" Content="Open Toolchains" Command="{Binding OpenToolchainsPageCommand}" />
                      </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding ElectronNotes}" IsVisible="{Binding HasElectronNotes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="muted" FontSize="12" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="inset" Padding="16,12" IsVisible="{Binding ElectronWorkflow, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock FontSize="12.5" Text="{Binding ElectronWorkflow}" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                  <!-- Browser app (Vite + React): Create desktop application — a separate desktop project, after showing exactly what changes -->
                  <StackPanel Spacing="12" IsVisible="{Binding ShowDesktopConversion}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="h3" Text="Create desktop application" VerticalAlignment="Center" />
                      <c:StatusChip Grid.Column="1" Status="{Binding ConversionTag}" />
                    </Grid>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ConversionCategory}" />
                    <TextBlock Classes="body secondary" Text="{Binding ConversionSummary}" TextWrapping="Wrap" />
                    <Border Classes="callout error" IsVisible="{Binding HasConversionBlockers}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Project configuration — not converted as it is" FontWeight="SemiBold" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding ConversionBlockers}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConversionFindingItem">
                              <StackPanel Spacing="1" Margin="0,2">
                                <SelectableTextBlock FontSize="12.5" Text="{Binding Message, StringFormat='• {0}'}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted mono" FontSize="11" Text="{Binding Location}" IsVisible="{Binding HasLocation}" Margin="10,0,0,0" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Border Classes="callout warning" IsVisible="{Binding HasConversionToolchainGaps}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Installed toolchains — missing on this computer" FontWeight="SemiBold" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding ConversionToolchainGaps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <SelectableTextBlock FontSize="12.5" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="small" HorizontalAlignment="Left" Content="Open Toolchains" Command="{Binding OpenToolchainsPageCommand}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ConversionToolchainText}" TextWrapping="Wrap"
                               IsVisible="{Binding ConversionToolchainText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Spacing="12" IsVisible="{Binding CanEditConversion}">
                      <Grid ColumnDefinitions="*,12,*,12,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="formlabel" Text="PRODUCT NAME" Margin="0" />
                          <TextBox Text="{Binding ConversionAppName}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                          <TextBlock Classes="formlabel" Text="APPLICATION IDENTIFIER" Margin="0" />
                          <TextBox Text="{Binding ConversionAppId}" FontFamily="{DynamicResource Hcg.Font.Mono}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="4">
                          <TextBlock Classes="formlabel" Text="VERSION" Margin="0" />
                          <TextBlock Text="{Binding ConversionVersion}" VerticalAlignment="Center" Margin="0,6,0,0" ToolTip.Tip="From package.json" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Spacing="4">
                        <TextBlock Classes="formlabel" Text="ICON" Margin="0" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConversionIconName}" FontWeight="Medium" />
                            <TextBlock Classes="muted" FontSize="11.5" Text="{Binding ConversionIconStatus}" TextWrapping="Wrap" IsVisible="{Binding !ConversionIconInvalid}" />
                            <TextBlock Classes="error" FontSize="11.5" Text="{Binding ConversionIconStatus}" TextWrapping="Wrap" IsVisible="{Binding ConversionIconInvalid}" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="small" Content="Choose…" Command="{Binding BrowseConversionIconCommand}" Margin="8,0,0,0" />
                          <Button Grid.Column="2" Classes="small ghost" Content="Default" Command="{Binding ClearConversionIconCommand}" IsVisible="{Binding HasConversionIcon}" Margin="6,0,0,0" />
                        </Grid>
                      </StackPanel>
                      <Grid ColumnDefinitions="*,12,*">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="formlabel" Text="TARGET PLATFORM AND ARCHITECTURE" Margin="0" />
                          <ComboBox ItemsSource="{Binding ConversionTargets}" SelectedItem="{Binding SelectedConversionTarget}" HorizontalAlignment="Stretch" PlaceholderText="No desktop target can be built on this computer" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                          <TextBlock Classes="formlabel" Text="PACKAGE FORMATS" Margin="0" />
                          <ItemsControl ItemsSource="{Binding ConversionFormats}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ConversionFormatItem">
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" Content="{Binding Label}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                      <TextBlock Classes="muted" FontSize="11.5" TextWrapping="Wrap"
                                 Text="Only targets this computer can package are offered: macOS apps are built on a Mac, Linux app folders on Linux. Windows packaging of Electron apps is not implemented in this version. This is a desktop app; it is never labelled as an iOS or Android app." />
                      <StackPanel Spacing="4">
                        <TextBlock Classes="formlabel" Text="OUTPUT FOLDER" Margin="0" />
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBox Text="{Binding ConversionOutputDirectory}" FontFamily="{DynamicResource Hcg.Font.Mono}" />
                          <Button Grid.Column="1" Classes="small" Content="Browse…" Command="{Binding BrowseConversionOutputCommand}" Margin="8,0,0,0" />
                        </Grid>
                      </StackPanel>
                      <Border Classes="inset" Padding="14,12">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Signing and notarization (separate operations)" FontWeight="SemiBold" FontSize="12.5" />
                          <ComboBox ItemsSource="{Binding ConversionSigningChoices}" SelectedItem="{Binding SelectedConversionSigning}" HorizontalAlignment="Stretch" IsVisible="{Binding IsMacHost}" />
                          <TextBlock FontSize="12" TextWrapping="Wrap"><Run Text="Signing: " FontWeight="SemiBold" /><Run Text="{Binding ConversionSigningStatus}" /></TextBlock>
                          <TextBlock FontSize="12" TextWrapping="Wrap"><Run Text="Notarization: " FontWeight="SemiBold" /><Run Text="{Binding ConversionNotarizationStatus}" /></TextBlock>
                        </StackPanel>
                      </Border>
                      <StackPanel Spacing="4">
                        <CheckBox IsChecked="{Binding ConversionUsePublicEnvironment}" Content="Use the web build's public VITE_ settings from the project's .env files" />
                        <TextBlock Classes="muted" FontSize="11.5" Text="{Binding ConversionEnvironmentText}" TextWrapping="Wrap" Margin="28,0,0,0" />
                      </StackPanel>
                    </StackPanel>
                    <Border Classes="callout warning" IsVisible="{Binding HasConversionWarnings}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Check before relying on the desktop app (backend, sign-in, network)" FontWeight="SemiBold" FontSize="12.5" />
                        <ItemsControl ItemsSource="{Binding ConversionWarnings}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConversionFindingItem">
                              <StackPanel Spacing="1" Margin="0,2">
                                <SelectableTextBlock FontSize="12.5" Text="{Binding Message, StringFormat='• {0}'}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted mono" FontSize="11" Text="{Binding Location}" IsVisible="{Binding HasLocation}" Margin="10,0,0,0" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <Expander Header="How HCG handles loading, routing, settings and security" HorizontalAlignment="Stretch" IsVisible="{Binding CanEditConversion}">
                      <ItemsControl ItemsSource="{Binding ConversionInfos}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ConversionFindingItem">
                            <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding Message, StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,2" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <StackPanel Spacing="10" IsVisible="{Binding ConversionPlan.CanApply, FallbackValue=False}">
                      <TextBlock Classes="formlabel" Text="FILES HCG WILL ADD OR CHANGE (IN THE NEW DESKTOP PROJECT ONLY)" Margin="0" />
                      <ItemsControl ItemsSource="{Binding ConversionChanges}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ConversionChangeItem">
                            <Expander HorizontalAlignment="Stretch" Margin="0,2">
                              <Expander.Header>
                                <StackPanel Spacing="1">
                                  <TextBlock FontSize="12.5"><Run Text="{Binding KindLabel}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding RelativePath}" FontFamily="{DynamicResource Hcg.Font.Mono}" /></TextBlock>
                                  <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Reason}" TextWrapping="Wrap" />
                                </StackPanel>
                              </Expander.Header>
                              <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                                <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding Preview}" />
                              </ScrollViewer>
                            </Expander>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding ConversionDestinationText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Classes="callout" IsVisible="{Binding ConversionExistingProjectText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <TextBlock FontSize="12.5" Text="{Binding ConversionExistingProjectText}" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanEditConversion}">
                      <Button Classes="primary" Content="Create desktop application" Command="{Binding CreateDesktopWorkspaceCommand}" />
                      <Button Classes="ghost" Content="Update preview" Command="{Binding PreviewDesktopConversionCommand}" IsVisible="{Binding ConversionPreviewStale}" />
                      <Button Classes="ghost" Content="Cancel" Command="{Binding CancelDesktopConversionCommand}" IsVisible="{Binding IsConverting}" />
                      <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" IsVisible="{Binding IsConverting}" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ConversionPreviewStale}"
                               Text="Options changed since the preview. Create desktop application checks them again before writing anything; Update preview shows the result first." />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding ConversionStatus}" TextWrapping="Wrap" IsVisible="{Binding IsConverting}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding CanEditConversion}"
                               Text="Next: the desktop project opens at the Build step. After you confirm that you trust the project, HCG installs its dependencies (npm ci), compiles the web app, packages it and verifies the result — four separate stages, cancellable at any time." />
                    <Border Classes="callout error" IsVisible="{Binding ConversionError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <SelectableTextBlock FontSize="12.5" Text="{Binding ConversionError}" TextWrapping="Wrap" />
                    </Border>
                    <Expander Header="Generation output" IsVisible="{Binding HasConversionLog}" HorizontalAlignment="Stretch">
                      <ScrollViewer MaxHeight="180">
                        <ItemsControl ItemsSource="{Binding ConversionLog}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Expander>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding OtherNodeProjectsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Classes="formlabel" Text="OTHER NODE.JS PROJECTS (NOT DESKTOP APPS)" Margin="0" />
                    <SelectableTextBlock Classes="muted" FontSize="12" Text="{Binding OtherNodeProjectsText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Classes="callout warning" IsVisible="{Binding HasMacXcodeProjects}">
                    <SelectableTextBlock FontSize="12.5" Text="{Binding MacXcodeProjectsText}" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="18" Margin="9,0,0,0">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="h2" Text="Required toolchains" />
                  <ItemsControl ItemsSource="{Binding Requirements}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RequirementItem">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                            <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </StackPanel>
                          <c:StatusChip Grid.Column="1" Status="{Binding Status}" VerticalAlignment="Top" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="callout warning" IsVisible="{Binding HasMissing}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="h3 warning" Text="{Binding MissingTitle}" />
                  <ItemsControl ItemsSource="{Binding MissingDependencies}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock FontSize="12.5" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" Text="{Binding MissingHint}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <!-- Not buildable as it is: explain, and offer HCG support (nothing is sent from here) -->
              <Border Classes="card" IsVisible="{Binding ShowSupportActions}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="What you can do" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="HCG Executable Maker cannot build this project as it is. Review the diagnostics, or ask HCG to support it: you choose what is sent and nothing leaves this computer until you submit." />
                  <WrapPanel>
                    <Button Classes="small ghost" Margin="0,0,8,6" Command="{Binding ViewDiagnosticsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Log}" Width="14" /><TextBlock Text="View diagnostics" /></StackPanel>
                    </Button>
                    <Button Classes="small" Margin="0,0,8,6" Command="{Binding RequestProjectSupportCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Support}" Width="14" /><TextBlock Text="Request project support" /></StackPanel>
                    </Button>
                    <Button Classes="small" Margin="0,0,8,6" Command="{Binding AnalyseWithAiCommand}" IsVisible="{Binding AiAnalysisAvailable}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Ai}" Width="14" /><TextBlock Text="AI analysis" /></StackPanel>
                    </Button>
                  </WrapPanel>
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding AiAnalysisNote}" IsVisible="{Binding !AiAnalysisAvailable}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="card" IsVisible="{Binding HasDiagnostics}">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="Findings" />
                  <ItemsControl ItemsSource="{Binding Diagnostics}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiagnosticItem">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                          <c:StatusChip Status="{Binding Severity}" VerticalAlignment="Top" Margin="0,0,10,0" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" />
                            <TextBlock Classes="muted mono" Text="{Binding Path}" IsVisible="{Binding HasPath}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- STEP 3 · CONFIGURE -->
          <Grid ColumnDefinitions="*,*" IsVisible="{Binding IsConfigureStep}">
            <Border Classes="card" Margin="0,0,9,0" VerticalAlignment="Top">
              <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                  <TextBlock Classes="h2" Text="Application identity" />
                  <TextBlock Classes="muted" Text="Branding of the generated application — independent of HCG Executable Maker." />
                </StackPanel>
                <Border Classes="callout" IsVisible="{Binding IsElectronBuild}">
                  <TextBlock FontSize="12" TextWrapping="Wrap"
                             Text="Electron app: electron-builder takes the name, version, app id, icon and signing identity from the project's configuration (electron-builder.yml or package.json). They are shown here for the output folder name; change them in the project." />
                </Border>
                <StackPanel>
                  <TextBlock Classes="formlabel" Text="APPLICATION NAME" />
                  <TextBox Text="{Binding AppName}" IsReadOnly="{Binding IsElectronBuild}" />
                </StackPanel>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,6,0">
                    <TextBlock Classes="formlabel" Text="PUBLISHER" />
                    <TextBox Text="{Binding Publisher}" PlaceholderText="e.g. Hakmi Capital Group" />
                  </StackPanel>
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Classes="formlabel" Text="VERSION" />
                    <TextBox Text="{Binding Version}" PlaceholderText="1.0.0" IsReadOnly="{Binding IsElectronBuild}" />
                  </StackPanel>
                </UniformGrid>
                <StackPanel>
                  <TextBlock Classes="formlabel" Text="APPLICATION IDENTIFIER (REVERSE-DNS)" />
                  <TextBox Text="{Binding AppId}" FontFamily="{DynamicResource Hcg.Font.Mono}" PlaceholderText="com.company.app" IsReadOnly="{Binding IsElectronBuild}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="formlabel" Text="DESCRIPTION" />
                  <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                </StackPanel>
                <Border Classes="divider" />
                <TextBlock Classes="formlabel" Text="APPLICATION ICON (PNG, ICO OR ICNS)" Margin="0" IsVisible="{Binding IdentityEditable}" />
                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IdentityEditable}">
                  <Border Width="84" Height="84" Classes="inset" Padding="8">
                    <Panel>
                      <Image Source="{Binding IconPreview}" Stretch="Uniform" />
                      <PathIcon Data="{StaticResource Icon.Image}" Width="26" Height="26" Foreground="{DynamicResource Hcg.Brush.TextMuted}"
                                IsVisible="{Binding IconPreview, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="6">
                    <TextBlock Text="{Binding IconFileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding IconSummary}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="small" Content="Choose icon…" Command="{Binding BrowseIconCommand}" />
                      <Button Classes="small ghost" Content="Remove" Command="{Binding ClearIconCommand}" IsVisible="{Binding HasIcon}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{Binding IconNotes}" IsVisible="{Binding IdentityEditable}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:IconNote">
                      <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2" Text="{Binding Text, StringFormat='• {0}'}"
                                 Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IdentityEditable}" Text="Your original icon file is never modified. Platform formats (.ico / .icns) are generated from it without distortion." />
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Spacing="18" Margin="9,0,0,0">
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="Target &amp; build" />
                    <TextBlock Classes="muted" Text="Platforms this project does not support are shown but cannot be selected." />
                  </StackPanel>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Classes="formlabel" Text="TARGET PLATFORM" />
                      <ComboBox ItemsSource="{Binding PlatformOptions}" SelectedItem="{Binding SelectedPlatform}">
                        <ComboBox.Styles>
                          <!-- Unsupported targets stay visible (with the reason) but cannot be chosen. -->
                          <Style Selector="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}" />
                          </Style>
                        </ComboBox.Styles>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Classes="formlabel" Text="ARCHITECTURE" />
                      <ComboBox ItemsSource="{Binding ArchitectureOptions}" SelectedItem="{Binding SelectedArchitecture}" />
                    </StackPanel>
                  </UniformGrid>
                  <Border Classes="callout" IsVisible="{Binding PlatformNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding PlatformNote}" FontSize="12" TextWrapping="Wrap" />
                  </Border>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,6,0" IsVisible="{Binding ShowConfigurationChoice}">
                      <TextBlock Classes="formlabel" Text="CONFIGURATION" />
                      <ComboBox ItemsSource="{Binding ConfigurationOptions}" SelectedItem="{Binding SelectedConfiguration}" />
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Classes="formlabel" Text="TIME LIMIT (MINUTES)" />
                      <NumericUpDown Value="{Binding TimeoutMinutes}" Minimum="1" Maximum="720" Increment="5" FormatString="0" />
                    </StackPanel>
                  </UniformGrid>
                  <CheckBox IsChecked="{Binding SelfContained}" IsVisible="{Binding IsDotNetBuild}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Self-contained" FontWeight="Medium" />
                      <TextBlock Classes="muted" Text="Bundle the .NET runtime — no installation required on the target machine." TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding SingleFile}" IsVisible="{Binding IsDotNetBuild}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Single-file executable" FontWeight="Medium" />
                      <TextBlock Classes="muted" Text="Package the app and its dependencies into one executable file." TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </Border>
              <Border Classes="card" IsVisible="{Binding IsSwiftBuild}">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="macOS app (Swift package)" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Written to the .app's Info.plist. The application name above is the display name (e.g. Distil); the executable keeps the product name." />
                  </StackPanel>
                  <Border Classes="callout" Padding="10">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SwiftPrefillNote}" />
                  </Border>
                  <StackPanel>
                    <TextBlock Classes="formlabel" Text="DELIVER AS" />
                    <ComboBox ItemsSource="{Binding SwiftKindOptions}" SelectedItem="{Binding SelectedSwiftKind}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="muted" FontSize="12" Margin="0,4,0,0" Text="{Binding SwiftKindNote}" TextWrapping="Wrap" />
                  </StackPanel>
                  <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,6,0">
                      <TextBlock Classes="formlabel" Text="BUILD NUMBER (CFBUNDLEVERSION)" />
                      <TextBox Text="{Binding SwiftBuildNumber}" PlaceholderText="1" />
                    </StackPanel>
                    <StackPanel Margin="6,0,0,0">
                      <TextBlock Classes="formlabel" Text="MINIMUM MACOS" />
                      <TextBox Text="{Binding SwiftMinimumMacOS}" PlaceholderText="from the executable" />
                    </StackPanel>
                  </UniformGrid>
                  <StackPanel IsVisible="{Binding IsSwiftGui}">
                    <TextBlock Classes="formlabel" Text="APP CATEGORY (LSAPPLICATIONCATEGORYTYPE)" />
                    <ComboBox ItemsSource="{Binding SwiftCategoryOptions}" SelectedItem="{Binding SelectedSwiftCategory}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding HasSwiftUsageDescriptions}">
                    <TextBlock Classes="formlabel" Text="PRIVACY USAGE DESCRIPTIONS (REQUIRED)" Margin="0" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="macOS shows this text when the app asks for permission, and terminates the app if the key is missing." />
                    <ItemsControl ItemsSource="{Binding SwiftUsageDescriptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SwiftUsageItem">
                          <StackPanel Spacing="4" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Heading}" FontWeight="Medium" FontSize="12.5" TextWrapping="Wrap" />
                            <TextBlock Classes="muted mono" FontSize="11" Text="{Binding Evidence, StringFormat='Detected: {0}'}" TextWrapping="Wrap" />
                            <TextBox Text="{Binding Text}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" PlaceholderText="Explain why the app needs this access." />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="card" IsVisible="{Binding HasSwiftContract}">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="Packaging contract" />
                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SwiftContractSummary}" />
                  </StackPanel>
                  <Border Classes="callout error" Padding="10" IsVisible="{Binding SwiftContractError, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="{Binding SwiftContractError}" />
                  </Border>
                  <StackPanel Spacing="6" IsVisible="{Binding HasSwiftContractCommands}">
                    <TextBlock Classes="formlabel" Text="COMMANDS RUN BEFORE SWIFT BUILD" Margin="0" />
                    <ItemsControl ItemsSource="{Binding SwiftContractCommands}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SwiftContractLine">
                          <StackPanel Spacing="2" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Description}" FontWeight="Medium" FontSize="12.5" TextWrapping="Wrap" />
                            <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding Command}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="4" IsVisible="{Binding HasSwiftContractContents}">
                    <TextBlock Classes="formlabel" Text="ADDED TO THE APP" Margin="0" />
                    <ItemsControl ItemsSource="{Binding SwiftContractContents}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <SelectableTextBlock Classes="mono" FontSize="11.5" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <CheckBox IsChecked="{Binding SwiftContractConfirmed}" IsVisible="{Binding HasSwiftContractCommands}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Run these commands while building" FontWeight="Medium" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="They come from the project and run on this computer with your account's permissions, like the build itself (not sandboxed). HCG runs them exactly as shown, without a shell, and refuses to build if the file changes after you confirm." />
                    </StackPanel>
                  </CheckBox>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="Output" />
                  <TextBlock Classes="formlabel" Text="OUTPUT DIRECTORY" Margin="0" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding OutputDirectory}" FontFamily="{DynamicResource Hcg.Font.Mono}" FontSize="12" />
                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap" Text="Each build writes into its own sub-folder named after the app, version and runtime." />
                </StackPanel>
              </Border>
              <Border Classes="callout error" IsVisible="{Binding HasConfigErrors}">
                <ItemsControl ItemsSource="{Binding ConfigErrors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="{Binding StringFormat='• {0}'}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Grid>

          <!-- STEP 4 · PACKAGE -->
          <Border Classes="card" IsVisible="{Binding IsPackageStep}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="2">
                <TextBlock Classes="h2" Text="Packaging formats" />
                <TextBlock Classes="muted" Text="Packaging runs after a successful build. Formats that are not implemented or need different tooling are disabled with the reason." />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding PackagingOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PackagingOptionItem">
                    <Border Classes="inset" Margin="0,0,0,10" Padding="16,14">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsEnabled}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,12,0">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                          <TextBlock Classes="secondary" FontSize="12.5" Text="{Binding Description}" TextWrapping="Wrap" />
                          <TextBlock Classes="warning" FontSize="12" Text="{Binding Reason}" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
                        </StackPanel>
                        <c:StatusChip Grid.Column="2" Status="{Binding Status}" VerticalAlignment="Top" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="inset" Padding="18,16" IsVisible="{Binding ShowInstallerOptions}">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="h3" Text="Windows installer options" />
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Name, publisher, version and icon come from Configure. The installer always creates a Start-menu shortcut and registers an uninstaller in Settings → Apps." />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="formlabel" Text="INSTALL FOR" />
                    <ComboBox ItemsSource="{Binding InstallScopeOptions}" SelectedItem="{Binding SelectedInstallScope}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Classes="formlabel" Text="INSTALLATION FOLDER NAME" />
                    <TextBox Text="{Binding InstallFolderName}" PlaceholderText="{Binding AppName}" />
                  </StackPanel>
                  <CheckBox IsChecked="{Binding OfferDesktopShortcut}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="Offer a desktop shortcut" FontWeight="Medium" />
                      <TextBlock Classes="muted" Text="Shown as an optional checkbox in the setup wizard." TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                  <CheckBox IsChecked="{Binding DesktopShortcutChecked}" IsEnabled="{Binding OfferDesktopShortcut}" Margin="28,0,0,0">
                    <TextBlock Text="Desktop shortcut checked by default" />
                  </CheckBox>
                  <CheckBox IsChecked="{Binding OfferLaunchAfterInstall}">
                    <TextBlock Text="Offer to launch the app when setup finishes" FontWeight="Medium" />
                  </CheckBox>
                </StackPanel>
              </Border>

              <!-- macOS distribution: signing, entitlements, installer and Mac App Store -->
              <Border Classes="inset" Padding="18,16" IsVisible="{Binding ShowDistribution}">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="h3" Text="macOS distribution" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SigningInventoryNote}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="small" Content="Refresh certificates" Command="{Binding RefreshSigningCommand}" VerticalAlignment="Top" />
                  </Grid>

                  <StackPanel Spacing="6" IsVisible="{Binding IsSwiftGui}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="formlabel" Text="SIGNING" />
                      <c:StatusChip Grid.Column="1" Status="{Binding DeveloperIdState}" />
                    </Grid>
                    <ComboBox ItemsSource="{Binding SigningModeOptions}" SelectedItem="{Binding SelectedSigningMode}" HorizontalAlignment="Stretch" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding DeveloperIdReason}" />
                    <StackPanel Spacing="6" IsVisible="{Binding IsDeveloperId}">
                      <TextBlock Classes="formlabel" Text="DEVELOPER ID APPLICATION CERTIFICATE" />
                      <ComboBox ItemsSource="{Binding DeveloperIdIdentities}" SelectedItem="{Binding SelectedDeveloperIdIdentity}" HorizontalAlignment="Stretch" />
                      <TextBlock Classes="formlabel" Text="HARDENED-RUNTIME ENTITLEMENTS (FROM THE SOURCES)" />
                      <TextBlock Classes="muted" FontSize="12" Text="None needed: the sources use no protected resource." IsVisible="{Binding !HasDeveloperIdEntitlements}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding DeveloperIdEntitlements}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EntitlementChoice">
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Heading}" FontWeight="Medium" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Evidence}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Explanation}" TextWrapping="Wrap" />
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding ShowPkgOptions}">
                    <TextBlock Classes="formlabel" Text="INSTALLER PACKAGE SIGNATURE" />
                    <ComboBox ItemsSource="{Binding InstallerIdentities}" SelectedItem="{Binding SelectedInstallerIdentity}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsSwiftGui}" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Unsigned packages are for testing on this Mac. Distribution needs a Developer ID Installer certificate and a Developer ID signed app, then notarization." />
                  </StackPanel>

                  <Expander IsVisible="{Binding IsSwiftGui}" HorizontalAlignment="Stretch">
                    <Expander.Header>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Mac App Store preparation" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <c:StatusChip Grid.Column="1" Status="{Binding AppStoreState}" Margin="12,0,0,0" />
                      </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="8">
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding AppStoreReason}" />
                      <TextBlock Classes="formlabel" Text="APPLE DISTRIBUTION CERTIFICATE" />
                      <ComboBox ItemsSource="{Binding AppStoreIdentities}" SelectedItem="{Binding SelectedAppStoreIdentity}" HorizontalAlignment="Stretch" />
                      <TextBlock Classes="formlabel" Text="MAC INSTALLER DISTRIBUTION CERTIFICATE" />
                      <ComboBox ItemsSource="{Binding AppStoreInstallerIdentities}" SelectedItem="{Binding SelectedAppStoreInstaller}" HorizontalAlignment="Stretch" />
                      <TextBlock Classes="formlabel" Text="MAC APP STORE PROVISIONING PROFILE" />
                      <Grid ColumnDefinitions="*,Auto">
                        <ComboBox ItemsSource="{Binding AppStoreProfiles}" SelectedItem="{Binding SelectedAppStoreProfile}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Classes="small" Content="Browse…" Command="{Binding BrowseProvisioningProfileCommand}" Margin="8,0,0,0" />
                      </Grid>
                      <TextBlock Classes="formlabel" Text="APP SANDBOX ENTITLEMENTS (FROM THE SOURCES; APP SANDBOX ITSELF IS ALWAYS ON)" />
                      <ItemsControl ItemsSource="{Binding AppStoreEntitlements}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EntitlementChoice">
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Heading}" FontWeight="Medium" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Evidence}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Explanation}" TextWrapping="Wrap" />
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Spacing="4" IsVisible="{Binding HasAppStoreReviews}">
                        <TextBlock Classes="formlabel" Text="REVIEW BEFORE SUBMITTING" />
                        <ItemsControl ItemsSource="{Binding AppStoreReviews}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="warning" FontSize="12" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel Spacing="4" IsVisible="{Binding HasAppStoreBlockers}">
                        <TextBlock Classes="formlabel" Text="BLOCKERS (NOT POSSIBLE IN THE APP SANDBOX)" />
                        <ItemsControl ItemsSource="{Binding AppStoreBlockers}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Classes="error" FontSize="12" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Expander>

                  <CheckBox IsChecked="{Binding EntitlementsConfirmed}" IsVisible="{Binding IsSwiftGui}">
                    <StackPanel Spacing="1">
                      <TextBlock Text="I reviewed these entitlements" FontWeight="Medium" />
                      <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                 Text="HCG proposes only what the sources need and never adds others. An unchecked entitlement disables that feature in the signed app; the summary lists it." />
                    </StackPanel>
                  </CheckBox>
                  <ItemsControl ItemsSource="{Binding DistributionErrors}" IsVisible="{Binding HasDistributionErrors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="error" FontSize="12.5" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- STEP 6 · RESULTS -->
          <StackPanel Spacing="18" IsVisible="{Binding IsResultsStep}">
            <Border Classes="card" Padding="26">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="h1" Text="{Binding ResultTitle}" />
                    <c:StatusChip Status="{Binding ResultTag}" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding ResultDetail}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Hcg.Brush.TextSecondary}" />
                  <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,6,0,0">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="DURATION" />
                      <TextBlock Text="{Binding ResultDuration}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="WARNINGS" />
                      <TextBlock Text="{Binding Result.WarningCount, FallbackValue=0}" FontWeight="SemiBold" Classes="warning" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="ERRORS" />
                      <TextBlock Text="{Binding Result.ErrorCount, FallbackValue=0}" FontWeight="SemiBold" Classes="error" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding ShowBuildFailureActions}" Margin="0,4,0,0">
                    <WrapPanel>
                      <Button Classes="small" Margin="0,0,8,0" Command="{Binding ExplainBuildErrorCommand}" IsVisible="{Binding AiExplainAvailable}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Ai}" Width="14" /><TextBlock Text="Explain this build error" /></StackPanel>
                      </Button>
                      <Button Classes="small ghost" Margin="0,0,8,0" Command="{Binding RequestBuildSupportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Support}" Width="14" /><TextBlock Text="Request support for this build" /></StackPanel>
                      </Button>
                    </WrapPanel>
                    <TextBlock Classes="muted" FontSize="12" IsVisible="{Binding !AiExplainAvailable}" TextWrapping="Wrap"
                               Text="{Binding AiExplainNote}" />
                  </StackPanel>
                  <!-- Own row: long output paths wrap instead of running under the action buttons. -->
                  <StackPanel Spacing="2" Margin="0,0,16,0">
                    <TextBlock Classes="label" Text="OUTPUT" />
                    <SelectableTextBlock Text="{Binding ResultOutput}" Classes="mono" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" Margin="20,0,0,0" MinWidth="200">
                  <Button Classes="primary" HorizontalAlignment="Stretch" Command="{Binding OpenOutputFolderCommand}" IsEnabled="{Binding HasResultArtifacts}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.Open}" />
                      <TextBlock Text="Open Output Folder" />
                    </StackPanel>
                  </Button>
                  <Button HorizontalAlignment="Stretch" Command="{Binding ExportArtifactsCommand}" IsEnabled="{Binding HasResultArtifacts}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.Export}" />
                      <TextBlock Text="Export Artifacts…" />
                    </StackPanel>
                  </Button>
                  <Button HorizontalAlignment="Stretch" Command="{Binding ViewBuildLogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.Log}" />
                      <TextBlock Text="View Build Log" />
                    </StackPanel>
                  </Button>
                  <Button HorizontalAlignment="Stretch" Command="{Binding RebuildWithChangesCommand}" Content="Adjust &amp; Rebuild" />
                  <Button HorizontalAlignment="Stretch" Classes="ghost" Command="{Binding StartNewBuildCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource Icon.NewBuild}" />
                      <TextBlock Text="Start New Build" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding ShowDistributionSteps}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Distribution steps" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Each step is explicit and reported on its own. Upload to App Store Connect and submission for review stay manual." />
                <WrapPanel>
                  <Button Content="Notarize with Apple…" Command="{Binding NotarizeCommand}" IsEnabled="{Binding CanNotarize}" Margin="0,0,8,8" />
                  <Button Content="Test install…" Command="{Binding TestInstallCommand}" IsEnabled="{Binding CanTestInstall}" Margin="0,0,8,8" />
                  <CheckBox Content="Launch after test install" IsChecked="{Binding LaunchAfterTestInstall}" IsEnabled="{Binding CanTestInstall}" Margin="0,0,16,8" />
                  <Button Content="Validate with App Store Connect…" Command="{Binding ValidateAppStoreCommand}" IsEnabled="{Binding CanValidateAppStore}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Classes="muted" FontSize="12" Text="{Binding NotarizeNote}" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunningDistributionAction}" />
                <ItemsControl ItemsSource="{Binding DistributionResults}" IsVisible="{Binding HasDistributionResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DistributionStepItem">
                      <Grid ColumnDefinitions="200,170,Auto,*" Margin="0,3">
                        <TextBlock Text="{Binding Artifact}" FontSize="12" Classes="secondary" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="Medium" />
                        <c:StatusChip Grid.Column="2" Status="{Binding Status}" Margin="0,0,10,0" />
                        <SelectableTextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ResultArtifacts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtifactItem">
                  <Border Classes="card" Margin="0,0,0,14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Hcg.Brush.CyanSoft}" VerticalAlignment="Top">
                          <PathIcon Data="{StaticResource Icon.Artifacts}" Width="18" Height="18" Foreground="{DynamicResource Hcg.Brush.Cyan}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0" Spacing="2">
                          <TextBlock Classes="h3" Text="{Binding Name}" />
                          <TextBlock Classes="muted" Text="{Binding FormatName}" />
                        </StackPanel>
                        <c:StatusChip Grid.Column="2" Status="{Binding Verification}" VerticalAlignment="Top" />
                      </Grid>
                      <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" Margin="54,0,0,0">
                        <TextBlock Classes="label" Text="SIZE" Margin="0,3" />
                        <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="12.5" Margin="0,3" />
                        <TextBlock Grid.Row="1" Classes="label" Text="LOCATION" Margin="0,3" />
                        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding Path}" TextWrapping="Wrap" Margin="0,3" />
                        <TextBlock Grid.Row="2" Classes="label" Text="{Binding ChecksumLabel}" Margin="0,3" TextWrapping="Wrap" />
                        <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding Sha256}" TextWrapping="Wrap" Margin="0,3" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Checks}" Margin="54,4,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CheckItem">
                            <Grid ColumnDefinitions="170,Auto,*" Margin="0,3">
                              <TextBlock Text="{Binding Name}" FontSize="12" Classes="secondary" />
                              <c:StatusChip Grid.Column="1" Status="{Binding Status}" Margin="0,0,10,0" />
                              <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="54,4,0,0">
                        <Button Classes="small" Command="{Binding $parent[UserControl].((vm:BuildWizardViewModel)DataContext).CopyArtifactPathCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Copy}" /><TextBlock Text="Copy Artifact Path" /></StackPanel>
                        </Button>
                        <Button Classes="small" Command="{Binding $parent[UserControl].((vm:BuildWizardViewModel)DataContext).CopyChecksumCommand}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Copy}" /><TextBlock Text="Copy SHA-256" /></StackPanel>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card" IsVisible="{Binding HasResultMessages}">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Warnings &amp; errors" />
                <ItemsControl ItemsSource="{Binding ResultMessages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItem">
                      <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4">
                        <c:StatusChip Status="{Binding Severity}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Code}" Margin="10,2,10,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="2" Spacing="1">
                          <SelectableTextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" />
                          <TextBlock Classes="muted mono" Text="{Binding Location}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- STEP 5 · BUILD (log fills the remaining height) -->
      <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsBuildStep}">
        <ScrollViewer MaxHeight="430" IsVisible="{Binding ShowTrustPanel}">
          <Grid ColumnDefinitions="*,*" Margin="0,0,6,0">
            <Border Classes="callout warning" Margin="0,0,9,0" Padding="20">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Data="{StaticResource Icon.Warning}" Foreground="{DynamicResource Hcg.Brush.Warning}" Width="18" Height="18" />
                  <TextBlock Classes="h2" Text="{Binding TrustTitle}" />
                </StackPanel>
                <Border Classes="callout success" IsVisible="{Binding DesktopWorkspaceNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <SelectableTextBlock FontSize="12.5" Text="{Binding DesktopWorkspaceNotice}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Classes="body" Text="{Binding TrustExplanation}" />
                <TextBlock Classes="body secondary" Text="{Binding SecretsStatement}" />
                <Border Classes="chip warning">
                  <TextBlock Text="{Binding IsolationDescription}" />
                </Border>
                <CheckBox IsChecked="{Binding TrustAcknowledged}" Margin="0,6,0,0">
                  <TextBlock Text="{Binding TrustLabel}" TextWrapping="Wrap" FontWeight="SemiBold" />
                </CheckBox>
                <Button Classes="primary" HorizontalAlignment="Left" Command="{Binding StartBuildCommand}" Margin="0,4,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Play}" />
                    <TextBlock Text="Start Build" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="9,0,0,0">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Build summary" />
                <ItemsControl ItemsSource="{Binding Summary}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SummaryRow">
                      <Grid ColumnDefinitions="120,*" Margin="0,3">
                        <TextBlock Classes="label" Text="{Binding Label}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>

        <Border Classes="card compact" IsVisible="{Binding IsBuilding}">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <StackPanel Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="eyebrow" Text="BUILD IN PROGRESS" />
              <TextBlock Classes="h2" Text="{Binding CurrentStage}" />
              <ProgressBar IsIndeterminate="True" MaxWidth="520" HorizontalAlignment="Left" Width="520" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" Margin="18,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="ELAPSED" />
              <TextBlock Classes="mono" FontSize="18" Text="{Binding Elapsed}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2" Margin="18,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="WARNINGS" />
              <TextBlock Classes="warning" FontSize="18" Text="{Binding LiveWarnings}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="2" Margin="18,0" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="ERRORS" />
              <TextBlock Classes="error" FontSize="18" Text="{Binding LiveErrors}" />
            </StackPanel>
            <Button Grid.Column="4" Classes="danger" Command="{Binding CancelBuildCommand}" VerticalAlignment="Center" IsEnabled="{Binding !IsCancelling}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Stop}" />
                <TextBlock Text="Cancel Build" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="0" Margin="0,14,0,0" ClipToBounds="True" IsVisible="{Binding HasBuildStarted}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,10">
              <TextBlock Classes="label" Text="LIVE BUILD LOG" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="muted" Text="Display limited to recent lines — full log is saved to disk" IsVisible="{Binding LogTruncated}" />
            </Grid>
            <ListBox x:Name="LogList" Classes="log" ItemsSource="{Binding LogLines}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogLineItem">
                  <Grid ColumnDefinitions="70,*">
                    <TextBlock Classes="log" Text="{Binding Time}" Opacity="0.45" />
                    <TextBlock Grid.Column="1" Classes="log" TextWrapping="Wrap" Text="{Binding Text}"
                               Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.success="{Binding IsSuccess}"
                               Classes.command="{Binding IsCommand}" Classes.info="{Binding IsInfo}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Panel>

    <!-- ===== Navigation bar ===== -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <Button Command="{Binding BackCommand}" IsVisible="{Binding ShowBack}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource Icon.ArrowLeft}" />
          <TextBlock Text="Back" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Classes="primary" Command="{Binding NextCommand}" IsVisible="{Binding ShowNext}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Continue" />
          <PathIcon Data="{StaticResource Icon.ArrowRight}" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</UserControl>
