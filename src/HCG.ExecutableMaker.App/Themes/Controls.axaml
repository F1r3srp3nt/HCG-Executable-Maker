<!-- HCG control styles. Colors are always DynamicResource tokens so themes can be swapped at runtime. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextPrimary}" />
  </Style>

  <!-- ===== Typography ===== -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="2.2" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Cyan}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextMuted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Hcg.Font.Mono}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Light" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="TextBlock.metal">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.MetalText}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Cyan}" />
  </Style>
  <Style Selector="TextBlock.success"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Success}" /></Style>
  <Style Selector="TextBlock.warning"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Warning}" /></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Error}" /></Style>

  <!-- ===== Surfaces ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.SurfaceGlass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.MetalBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Card}" />
    <Setter Property="Padding" Value="{DynamicResource Hcg.Padding.Card}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Hcg.Shadow.Card}" />
  </Style>
  <Style Selector="Border.card.interactive">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card.interactive:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.SurfaceGlassHover}" />
  </Style>
  <Style Selector="Border.card.compact">
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Control}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Divider}" />
  </Style>
  <Style Selector="Border.accentline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.AccentLine}" />
  </Style>

  <!-- Callouts -->
  <Style Selector="Border.callout">
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Control}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanFaint}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.CyanSoft}" />
  </Style>
  <Style Selector="Border.callout.warning">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.WarningSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Warning}" />
  </Style>
  <Style Selector="Border.callout.error">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.ErrorSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Error}" />
  </Style>
  <Style Selector="Border.callout.success">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.SuccessSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Success}" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Pill}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.NeutralSoft}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Neutral}" />
  </Style>
  <Style Selector="Border.chip.success"><Setter Property="Background" Value="{DynamicResource Hcg.Brush.SuccessSoft}" /></Style>
  <Style Selector="Border.chip.success > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Success}" /></Style>
  <Style Selector="Border.chip.warning"><Setter Property="Background" Value="{DynamicResource Hcg.Brush.WarningSoft}" /></Style>
  <Style Selector="Border.chip.warning > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Warning}" /></Style>
  <Style Selector="Border.chip.error"><Setter Property="Background" Value="{DynamicResource Hcg.Brush.ErrorSoft}" /></Style>
  <Style Selector="Border.chip.error > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Error}" /></Style>
  <Style Selector="Border.chip.info"><Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanSoft}" /></Style>
  <Style Selector="Border.chip.info > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Cyan}" /></Style>

  <!-- ===== Buttons ===== -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Control}" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.SurfaceGlass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.MetalBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.SurfaceGlassHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Cyan}" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.42" />
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.SurfaceGlass}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.AccentGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Cyan}" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.OnAccent}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Hcg.Shadow.Glow}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextMuted}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextSecondary}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanFaint}" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Cyan}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Error}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.ErrorSoft}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.ErrorSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Error}" />
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Error}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button PathIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- ===== Inputs ===== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Divider}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Control}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Divider}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Control}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.AccentGradient}" />
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanFaint}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
  </Style>

  <!-- ===== Sidebar navigation ===== -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Hcg.Radius.Control}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanFaint}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanSoft}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanSoft}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem Border.indicator">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected Border.indicator">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextSecondary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.Cyan}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem TextBlock.navtext">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextSecondary}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navtext">
    <Setter Property="Foreground" Value="{DynamicResource Hcg.Brush.TextPrimary}" />
  </Style>

  <!-- Plain item lists: no selection chrome. -->
  <Style Selector="ListBox.plain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter, ListBox.plain ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.selectable ListBoxItem:selected Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource Hcg.Brush.Cyan}" />
  </Style>

  <!-- Build log -->
  <Style Selector="ListBox.log">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.LogBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="ListBox.log ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBox.log ListBoxItem:pointerover /template/ ContentPresenter, ListBox.log ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hcg.Brush.CyanFaint}" />
  </Style>

</Styles>
