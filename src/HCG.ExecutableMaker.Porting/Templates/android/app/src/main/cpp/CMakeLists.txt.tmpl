# Generated by HCG Executable Maker (Linux → Android port).
# The original project is included unchanged with add_subdirectory and built with the Android NDK toolchain.
# The sources, include directories, definitions and libraries of its executable target "{{TARGET}}" are reused in a
# shared library that the Android console host loads; the program's own main() is called unchanged.
cmake_minimum_required(VERSION 3.18.1)
project(hcgport C CXX)

set(HCG_PROGRAM_DIR "${CMAKE_CURRENT_SOURCE_DIR}/{{PROGRAM_DIR}}")
{{FIND_PACKAGES}}
add_subdirectory("${HCG_PROGRAM_DIR}" program EXCLUDE_FROM_ALL)

get_target_property(HCG_SOURCES {{TARGET}} SOURCES)
get_target_property(HCG_SOURCE_DIR {{TARGET}} SOURCE_DIR)
set(HCG_ABSOLUTE_SOURCES "")
foreach(source IN LISTS HCG_SOURCES)
  if(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
    list(APPEND HCG_ABSOLUTE_SOURCES "${source}")
  else()
    list(APPEND HCG_ABSOLUTE_SOURCES "${HCG_SOURCE_DIR}/${source}")
  endif()
endforeach()

add_library(hcgport SHARED hcg_console_bridge.c ${HCG_ABSOLUTE_SOURCES})
target_include_directories(hcgport PRIVATE $<TARGET_PROPERTY:{{TARGET}},INCLUDE_DIRECTORIES>)
target_compile_definitions(hcgport PRIVATE $<TARGET_PROPERTY:{{TARGET}},COMPILE_DEFINITIONS>)
target_compile_options(hcgport PRIVATE $<TARGET_PROPERTY:{{TARGET}},COMPILE_OPTIONS>)
foreach(property C_STANDARD C_STANDARD_REQUIRED C_EXTENSIONS CXX_STANDARD CXX_STANDARD_REQUIRED CXX_EXTENSIONS)
  get_target_property(value {{TARGET}} ${property})
  if(NOT value STREQUAL "value-NOTFOUND")
    set_target_properties(hcgport PROPERTIES ${property} "${value}")
  endif()
endforeach()

# pthread and rt are part of Android's libc (bionic): there are no separate libraries to link.
get_target_property(HCG_LIBRARIES {{TARGET}} LINK_LIBRARIES)
if(HCG_LIBRARIES STREQUAL "HCG_LIBRARIES-NOTFOUND")
  set(HCG_LIBRARIES "")
endif()
list(REMOVE_ITEM HCG_LIBRARIES pthread rt -lpthread -lrt)
target_link_libraries(hcgport PRIVATE ${HCG_LIBRARIES} log)

# exit() in the program returns to the console host instead of closing the app.
target_link_options(hcgport PRIVATE "-Wl,--wrap=exit")
