// Generated by HCG Executable Maker (Linux → Android port).
//
// Console host for the original command-line program "{{PROGRAM}}". It shows the program's output, lets the user enter
// command-line arguments and type standard input. This is the UI adaptation for a terminal program: the program
// itself is unchanged and runs in-process through JNI (see src/main/cpp/hcg_console_bridge.c).
package hcg.port.console;

import android.app.Activity;
import android.graphics.Typeface;
import android.os.Bundle;
import android.text.InputType;
import android.util.TypedValue;
import android.view.Gravity;
import android.view.ViewGroup;
import android.view.inputmethod.EditorInfo;
import android.widget.Button;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;

import java.io.ByteArrayOutputStream;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Pattern;

public final class MainActivity extends Activity {
    static {
        System.loadLibrary("hcgport");
    }

    private static final String PROGRAM = "{{PROGRAM}}";
    private static final String DEFAULT_ARGUMENTS = "{{DEFAULT_ARGUMENTS}}";
    private static final Pattern ANSI = Pattern.compile("\u001B\\[[0-9;?]*[ -/]*[@-~]");

    private static boolean started;
    private static boolean ran;

    private final ByteArrayOutputStream pending = new ByteArrayOutputStream();
    private TextView console;
    private ScrollView scroll;
    private EditText arguments;
    private EditText input;
    private Button run;

    private native boolean nativeStart();
    private native int nativeRun(String[] args, String home, String tmp);
    private native void nativeWriteStdin(byte[] data);
    private native void nativeCloseStdin();

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);
        int pad = dp(12);
        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(pad, pad, pad, pad);
        root.setFitsSystemWindows(true);

        TextView title = new TextView(this);
        title.setText(PROGRAM + " — console");
        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 20);
        title.setTypeface(Typeface.DEFAULT_BOLD);
        root.addView(title);

        LinearLayout argsRow = new LinearLayout(this);
        argsRow.setGravity(Gravity.CENTER_VERTICAL);
        arguments = new EditText(this);
        arguments.setHint("Arguments");
        arguments.setSingleLine(true);
        arguments.setTypeface(Typeface.MONOSPACE);
        String extraArgs = getIntent().getStringExtra("hcg.args");
        arguments.setText(extraArgs != null ? extraArgs : DEFAULT_ARGUMENTS);
        argsRow.addView(arguments, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        run = new Button(this);
        run.setText("Run");
        run.setOnClickListener(v -> runProgram());
        argsRow.addView(run);
        root.addView(argsRow);

        scroll = new ScrollView(this);
        console = new TextView(this);
        console.setTypeface(Typeface.MONOSPACE);
        console.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13);
        console.setTextIsSelectable(true);
        console.setText("Tap Run to start " + PROGRAM + ".\n");
        scroll.addView(console);
        root.addView(scroll, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f));

        LinearLayout inputRow = new LinearLayout(this);
        inputRow.setGravity(Gravity.CENTER_VERTICAL);
        input = new EditText(this);
        input.setHint("Standard input");
        input.setSingleLine(true);
        input.setInputType(InputType.TYPE_CLASS_TEXT);
        input.setImeOptions(EditorInfo.IME_ACTION_SEND);
        input.setOnEditorActionListener((v, actionId, event) -> { sendLine(); return true; });
        inputRow.addView(input, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        Button send = new Button(this);
        send.setText("Send");
        send.setOnClickListener(v -> sendLine());
        inputRow.addView(send);
        Button eof = new Button(this);
        eof.setText("Close input");
        eof.setOnClickListener(v -> nativeCloseStdin());
        inputRow.addView(eof);
        root.addView(inputRow);

        setContentView(root);
        if (!started) started = nativeStart();
        if (ran) {
            run.setEnabled(false);
            console.setText("The program already ran in this app session. Restart the app to run it again.\n");
        } else if (getIntent().getBooleanExtra("hcg.autorun", false)) {
            runProgram();
        }
    }

    private void runProgram() {
        if (ran) return;
        ran = true;
        run.setEnabled(false);
        console.setText("");
        List<String> argv = new ArrayList<>();
        argv.add(PROGRAM);
        argv.addAll(split(arguments.getText().toString()));
        String home = getFilesDir().getAbsolutePath();
        String tmp = getCacheDir().getAbsolutePath();
        // A large stack: desktop programs expect more than Android's default thread stack.
        Thread worker = new Thread(null, () -> {
            int code = nativeRun(argv.toArray(new String[0]), home, tmp);
            try { Thread.sleep(200); } catch (InterruptedException ignored) { }
            runOnUiThread(() -> {
                flushPending(true);
                append("\n[exit code " + code + "]\n");
                android.util.Log.i("HCGPort", "[exit code " + code + "]");
            });
        }, "program-main", 16L * 1024 * 1024);
        worker.start();
    }

    private void sendLine() {
        String line = input.getText().toString() + "\n";
        input.setText("");
        append(line);
        nativeWriteStdin(line.getBytes(StandardCharsets.UTF_8));
    }

    /** Called by the native reader thread with raw output bytes. */
    @SuppressWarnings("unused")
    private void onNativeOutput(byte[] bytes) {
        runOnUiThread(() -> {
            pending.write(bytes, 0, bytes.length);
            flushPending(false);
        });
    }

    /** Decodes complete lines (UTF-8 sequences may be split across reads). */
    private void flushPending(boolean all) {
        byte[] data = pending.toByteArray();
        int end = data.length;
        if (!all) {
            end = -1;
            for (int i = data.length - 1; i >= 0; i--) if (data[i] == '\n') { end = i + 1; break; }
            if (end < 0) return;
        }
        String text = new String(data, 0, end, StandardCharsets.UTF_8);
        pending.reset();
        pending.write(data, end, data.length - end);
        append(ANSI.matcher(text).replaceAll(""));
    }

    private void append(String text) {
        console.append(text);
        scroll.post(() -> scroll.fullScroll(ScrollView.FOCUS_DOWN));
    }

    /** Splits arguments like a shell would for plain words and "quoted strings". */
    static List<String> split(String s) {
        List<String> out = new ArrayList<>();
        StringBuilder cur = new StringBuilder();
        boolean inQuotes = false, has = false;
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '"') { inQuotes = !inQuotes; has = true; continue; }
            if (Character.isWhitespace(c) && !inQuotes) {
                if (has) { out.add(cur.toString()); cur.setLength(0); has = false; }
                continue;
            }
            cur.append(c);
            has = true;
        }
        if (has) out.add(cur.toString());
        return out;
    }

    private int dp(int v) {
        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, getResources().getDisplayMetrics());
    }
}
